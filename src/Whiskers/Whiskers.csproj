<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <Version>1.0.0</Version>
    <Product>Whiskers</Product>
    <!-- R1-52: the SDK adds the framework web-assets package only when it sees .razor files. Said explicitly, so a
         restore of the project file alone (the Dockerfile's cached restore layer) resolves the same packages as a full
         checkout and the locked restore matches packages.lock.json. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="7.1.0" />
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Docker.DotNet.X509" Version="3.125.15" />
    <PackageReference Include="KubernetesClient" Version="21.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <!-- R1-54: SMTP over a socket the outbound guard opened. MimeKit (its dependency) pulls in
         System.Security.Cryptography.Pkcs below the current servicing release (10.0.13 with MimeKit 4.18.2; 10.0.0 carried
         known advisories): pinned to the latest 10.0.x patch. -->
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time only: powers `dotnet ef migrations add` and the design-time context factory.
         A plain reference (full assets) is intentional so IDesignTimeDbContextFactory compiles. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageReference Include="NCrontab" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Whiskers.Data\Whiskers.Data.csproj" />
    <ProjectReference Include="..\Whiskers.Migrations.Sqlite\Whiskers.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Whiskers.Migrations.Postgres\Whiskers.Migrations.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The output cap lives inside HostCommandExecutor and is the mechanism the Trivy truncation bug turned
         on. A test that mocks around it would pass while the cap itself was broken, so the reader is opened
         to the test project rather than tested through a stand-in. -->
    <InternalsVisibleTo Include="Whiskers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped to the hosts by ScriptAutoPatchRunner; a fixed logical name so the namespace layout can move. -->
    <EmbeddedResource Include="Services\AutoPatch\img-update.sh" LogicalName="Whiskers.AutoPatch.img-update.sh" />
  </ItemGroup>

</Project>
