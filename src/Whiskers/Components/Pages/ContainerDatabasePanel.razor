    // === CSV Download ===

    private async Task DownloadCsv()
    {
        if (_dbResult == null || !_dbResult.Columns.Any()) return;

        var sb = new System.Text.StringBuilder();

        // Header
        sb.AppendLine(string.Join(",", _dbResult.Columns.Select(EscapeCsvField)));

        // Rows — no limit
        foreach (var row in _dbResult.Rows)
        {
            sb.AppendLine(string.Join(",", row.Select(EscapeCsvField)));
        }

        var csv = sb.ToString();
        var fileName = $"query_{(_dbSelectedDatabase ?? "db")}_{DateTime.Now:yyyyMMdd_HHmmss}.csv";

        // Trigger download via JS
        await JS.InvokeVoidAsync("Whiskers.downloadCsv", fileName, csv);
    }

    private static string EscapeCsvField(string field)
    {
        if (string.IsNullOrEmpty(field)) return "\"\"";
        if (field.Contains(',') || field.Contains('"') || field.Contains('\n') || field.Contains('\r'))
            return $"\"{field.Replace("\"", "\"\"")}\"";
        return field;
    }

    // === Database Methods ===

    private async Task LoadDatabaseInfo()
    {
        try
        {
            // Get env vars to extract credentials
            var env = await DockerService.GetContainerEnvAsync(ContainerId, _resolvedServerId);
            _dbCreds = Whiskers.Services.Database.DatabaseDetector.ExtractCredentials(env, _container!.DatabaseType);
            _dbSelectedDatabase = _dbCreds.Database;

            // Load database list
            _dbDatabases = await DatabaseService.GetDatabasesAsync(ContainerId, _container.DatabaseType, _dbCreds, _resolvedServerId);

            // Load tables for default database
            if (!string.IsNullOrEmpty(_dbSelectedDatabase))
                _dbTables = await DatabaseService.GetTablesAsync(ContainerId, _dbSelectedDatabase, _container.DatabaseType, _dbCreds, _resolvedServerId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ContainerDetail_Db_LoadError", ex.Message].Value, Severity.Error);
        }
        finally
        {
            _dbLoaded = true;
        }
    }

    private async Task OnDatabaseChanged(string database)
    {
        _dbSelectedDatabase = database;
        _dbTables.Clear();
        _dbColumns.Clear();
        _dbSelectedTable = null;

        if (_dbCreds != null && _container != null)
        {
            _dbCreds.Database = database;
            _dbTables = await DatabaseService.GetTablesAsync(ContainerId, database, _container.DatabaseType, _dbCreds, _resolvedServerId);
        }
    }

