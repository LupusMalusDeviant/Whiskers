@page "/self-status"
@attribute [Authorize]
@using Whiskers.Services.Docker.Budget
@using Whiskers.Services.LogMonitor
@using Whiskers.Services.LogMonitor.Hygiene
@using Whiskers.Services.Observability
@using Whiskers.Services.Observability.SelfMetrics
@inject ISelfMetrics SelfMetrics
@inject IServerBudget Budget
@inject IServerCircuitBreaker Circuit
@inject ILoopSuspensionService Suspension
@inject ILogMonitorService LogMonitor
@inject ILogScanExclusions Exclusions
@inject IServerConfigService ServerConfig
@inject Whiskers.Services.AuditLog.IAuditLogService AuditLog
@inject Whiskers.Services.Auth.ICurrentUserService CurrentUser
@inject Whiskers.Services.Notifications.IInAppNotificationStore Alerts
@inject Whiskers.Services.Observability.Outcomes.IActionOutcomeService Outcomes
@using Whiskers.Services.Observability.Outcomes
@implements IDisposable

@* "Is Whiskers still working?" — Plan-0003 WP4.

   Whiskers exported the container inventory of the whole fleet and not one number about its own behaviour.
   On 2026-08-26 the log monitor wrote "timed out after 15s" every cycle for six days; the incident report
   calls that the earliest and most precise signal of the whole event, and nothing surfaced it.

   The judgement lives in SelfStatusPresenter, not here, and it reads its threshold from ScanSupervisor — so
   this page, the alert and the MCP tool cannot disagree about what "fine" means. A view with its own quietly
   different threshold would be worse than none: it would look authoritative while contradicting the alert
   that woke someone up. *@

<PageTitle>Whiskers self-status</PageTitle>

<div class="sw-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div class="sw-page-icon"><MudIcon Icon="@Icons.Material.Filled.Insights" Size="Size.Large" /></div>
        <div>
            <MudText Typo="Typo.h5">Whiskers about itself</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Whether the background checks are actually running — read this before trusting an absence of alerts.
            </MudText>
        </div>
    </MudStack>
</div>

@if (_stalled > 0)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @_stalled of @_loops.Count loop/server pairs have not completed a cycle recently.
        While a loop is stalled its silence means nothing — findings from those servers are neither good news nor bad.
    </MudAlert>
}
else if (_loops.Count > 0)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">
        Every loop with a declared cadence has completed a cycle recently, so an absence of findings can be taken
        at face value.
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        No loop has recorded a cycle yet. Just after a start that is ordinary; ten minutes in it means every
        background loop is failing before it can record anything.
    </MudAlert>
}

<MudText Typo="Typo.h6" Class="mb-2">Loops</MudText>
<MudTable Items="@_loops" Dense="true" Hover="true" Class="mb-6">
    <HeaderContent>
        <MudTh>Loop</MudTh>
        <MudTh>Server</MudTh>
        <MudTh>State</MudTh>
        <MudTh>Last success</MudTh>
        <MudTh>Cycle</MudTh>
        <MudTh>Cycles / failed</MudTh>
        <MudTh>Cadence</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Loop">@context.Loop</MudTd>
        <MudTd DataLabel="Server">@context.ServerName</MudTd>
        <MudTd DataLabel="State">
            <MudChip T="string" Size="Size.Small" Color="@ColourFor(context.Verdict)" Variant="Variant.Filled">
                @LabelFor(context)
            </MudChip>
        </MudTd>
        @* An age, never a timestamp: "14:02" makes the reader do the subtraction, and doing it wrong is
           exactly how a six-day-old failure goes unnoticed. *@
        <MudTd DataLabel="Last success">@SelfStatusPresenter.Age(context.Age)</MudTd>
        <MudTd DataLabel="Cycle">@($"{context.LastDuration.TotalMilliseconds:0} ms")</MudTd>
        <MudTd DataLabel="Cycles / failed">@context.Cycles / @context.Failures</MudTd>
        <MudTd DataLabel="Cadence">
            @(context.ExpectedInterval is { } i ? SelfStatusPresenter.Age(i).Replace(" ago", "") : "—")
        </MudTd>
    </RowTemplate>
</MudTable>

<MudText Typo="Typo.h6" Class="mb-2">Load and circuit state</MudText>
<MudTable Items="@_servers" Dense="true" Hover="true">
    <HeaderContent>
        <MudTh>Server</MudTh>
        <MudTh>Circuit</MudTh>
        <MudTh>Background</MudTh>
        <MudTh>Interactive</MudTh>
        <MudTh>Background checks</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Server">@context.ServerName</MudTd>
        <MudTd DataLabel="Circuit">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                     Color="@(context.Circuit == ServerCircuitState.Closed ? Color.Success : Color.Warning)">
                @context.Circuit
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Background">@context.BackgroundInFlight / @context.BackgroundLimit</MudTd>
        <MudTd DataLabel="Interactive">@context.InteractiveInFlight / @context.InteractiveLimit</MudTd>
        <MudTd DataLabel="Background checks">
            @if (context.Paused)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                    paused — @context.PauseReason
                </MudChip>
            }
            else
            {
                <MudText Typo="Typo.body2">running</MudText>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@* Plan-0002 WP5 and Plan-0007 WP2.1 — the two ways a container can be missing from the log scan. They look
   the same from outside (no findings) and mean completely different things, so they are named apart here:
   one is a fault the scan is backing off from, the other is a deliberate exclusion. Neither is "healthy",
   and neither is "failed". *@
<MudText Typo="Typo.h6" Class="mt-6 mb-2">Containers not being read</MudText>

@if (_suspendedContainers.Count == 0 && _exclusions.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mb-4">Every container's logs are being scanned.</MudText>
}
else
{
    <MudTable Items="@_notRead" Dense="true" Hover="true" Class="mb-4">
        <HeaderContent>
            <MudTh>Container</MudTh>
            <MudTh>Server</MudTh>
            <MudTh>Why</MudTh>
            <MudTh>Detail</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Container">@context.Container</MudTd>
            <MudTd DataLabel="Server">@context.ServerName</MudTd>
            <MudTd DataLabel="Why">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(context.IsFault ? Color.Warning : Color.Info)">
                    @(context.IsFault ? "unreadable" : "excluded")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Detail">@context.Detail</MudTd>
        </RowTemplate>
    </MudTable>
}

@* Plan-0006 WP5. The question this answers is not "what did Whiskers do" — the timeline below covers that
   — but "did any of it help". Whiskers has always counted an action as successful when the call returned
   without an error, and this section is the first place that assumption is put next to a measurement. *@
@* These two database-backed sections are not on the five-second timer (see RefreshTimelineAsync), so
   each gets an explicit refresh — both buttons reload both sections. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-6 mb-2">
    <MudText Typo="Typo.h6">Did the automatic actions help?</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="_timelineLoading" OnClick="RefreshTimelineOnDemandAsync">Refresh</MudButton>
</MudStack>

@if (_outcomeRows.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mb-4">
        Whiskers has taken no automatic actions in the last 7 days.
    </MudText>
}
else
{
    <MudTable Items="@_outcomeRows" Dense="true" Hover="true" Class="mb-2">
        <HeaderContent>
            <MudTh>Action</MudTh>
            <MudTh>Effective</MudTh>
            <MudTh>Worked / changed nothing</MudTh>
            <MudTh>Not measurable</MudTh>
            <MudTh>Still open</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Action">@context.ActionKind</MudTd>
            <MudTd DataLabel="Effective">
                @if (context.HitRate is { } rate)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                             Color="@(context.Trust == RateTrust.Unreliable ? Color.Default : rate >= 0.7 ? Color.Success : Color.Warning)">
                        @($"{rate * 100:0}%")
                    </MudChip>
                    @if (context.Trust == RateTrust.Unreliable)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-inline ml-1">unreliable</MudText>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption">—</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Worked / changed nothing">@context.Worked / @context.DidNotWork</MudTd>
            @* Never folded into the rate, and never left out either: a gap that is not shown is coverage
               the table is silently claiming. *@
            <MudTd DataLabel="Not measurable">@context.NotMeasurable</MudTd>
            <MudTd DataLabel="Still open">@context.Pending</MudTd>
        </RowTemplate>
    </MudTable>

    @foreach (var row in _outcomeRows.Where(r => r.Caveat.Length > 0))
    {
        <MudText Typo="Typo.caption" Class="d-block"><b>@row.ActionKind:</b> @row.Caveat</MudText>
    }
}

@if (_overdueWarning.Length > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2 mb-4">@_overdueWarning</MudAlert>
}

<MudText Typo="Typo.caption" Class="mb-4 d-block">
    An action that changed nothing usually means the cause was somewhere other than where the action was
    aimed. For Whiskers' own throttles it means something sharper: monitoring was taken off a server for no
    benefit. Rollback is deliberately not automatic yet — the plan asks for four weeks of these numbers first.
</MudText>

@* Plan-0003 WP5 — "what happened at 14:02?". Self-inflicted load is the hardest kind to attribute: the
   curve shows the effect and nothing shows the cause. Human actions and Whiskers' own decisions belong on
   one list, because a pause or an open circuit changes the numbers with nobody having touched the fleet.

   Everything is computed in UTC and converted only here, at the point of display. A timeline with an offset
   in it is worse than no timeline — it will confidently suggest that the thing which happened AFTER the
   spike caused it. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-6 mb-2">
    <MudText Typo="Typo.h6">What has been happening</MudText>
    <MudSpacer />
    <MudText Typo="Typo.caption">last 6 hours · times shown in @_timeZoneLabel</MudText>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
               Disabled="_timelineLoading" OnClick="RefreshTimelineOnDemandAsync">Refresh</MudButton>
</MudStack>

@if (_timeline.Count == 0)
{
    <MudText Typo="Typo.body2">Nothing has changed on the fleet in the last six hours.</MudText>
}
else
{
    <MudTimeline TimelinePosition="TimelinePosition.Start" Class="mb-4">
        @foreach (var entry in _timeline)
        {
            <MudTimelineItem Size="Size.Small"
                             Color="@(entry.Success ? (entry.Actor == "Whiskers" ? Color.Info : Color.Default) : Color.Error)">
                <MudText Typo="Typo.body2">
                    <b>@Local(entry.AtUtc)</b> — @entry.Summary
                    @if (!entry.Success)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="d-inline"> (failed)</MudText>
                    }
                </MudText>
                <MudText Typo="Typo.caption">
                    @(entry.Actor ?? "unknown")
                    @if (entry.ServerId is { } sid)
                    {
                        @($" · {ServerName(sid)}")
                    }
                    @if (entry.AuditId is not null)
                    {
                        <MudLink Href="/audit-log" Typo="Typo.caption" Class="ml-2">audit log</MudLink>
                    }
                </MudText>
            </MudTimelineItem>
        }
    </MudTimeline>
}

<MudText Typo="Typo.caption" Class="mt-4 d-block">
    A <b>skipped</b> server is deliberately not covered by that loop — not a fault, but no findings will come
    from it either. <b>Unjudged</b> means the loop declares no cadence, so there is no basis for a verdict;
    inventing a threshold would make this page a source of noise.
    <b>Unreadable</b> containers are a fault the scan is backing off from and will retry;
    <b>excluded</b> ones are deliberate — Whiskers' own access path, whose logs are the record of this scan.
    Both still get health, metric and CVE monitoring; only their log content is skipped.
</MudText>

@code {
    private IReadOnlyList<LoopRow> _loops = Array.Empty<LoopRow>();
    private IReadOnlyList<ServerLoadRow> _servers = Array.Empty<ServerLoadRow>();
    private IReadOnlyList<SuspendedContainer> _suspendedContainers = Array.Empty<SuspendedContainer>();
    private IReadOnlyList<LogScanExclusion> _exclusions = Array.Empty<LogScanExclusion>();
    private IReadOnlyList<UnreadContainerRow> _notRead = Array.Empty<UnreadContainerRow>();
    private IReadOnlyList<TimelineEntry> _timeline = Array.Empty<TimelineEntry>();
    private IReadOnlyList<OutcomeRow> _outcomeRows = Array.Empty<OutcomeRow>();
    private string _overdueWarning = "";
    private readonly string _timeZoneLabel = TimeZoneInfo.Local.StandardName;
    private int _stalled;
    private Timer? _timer;

    /// <summary>The timeline window. Long enough to cover "it started sometime this morning", short enough
    /// that the list stays readable without paging.</summary>
    private static readonly TimeSpan TimelineWindow = TimeSpan.FromHours(6);
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await CurrentUser.HasRoleAsync(AppRole.Admin);
        Refresh();
        await RefreshTimelineAsync();

        // Reading these costs no Docker call and no database round trip — they are process memory — so a
        // five-second refresh is free. That property is pinned by a test; if it ever stops being true, this
        // page becomes load on the fleet it is reporting on.
        _timer = new Timer(_ => InvokeAsync(() => { Refresh(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void Refresh()
    {
        var names = ServerConfig.GetServers().ToDictionary(s => s.Id, s => s.Name, StringComparer.OrdinalIgnoreCase);

        _loops = SelfStatusPresenter.LoopRows(
            SelfMetrics.Loops(), DateTime.UtcNow, id => names.GetValueOrDefault(id, id));
        _servers = SelfStatusPresenter.ServerRows(ServerConfig.GetEnabledServers(), Budget, Circuit, Suspension);
        _stalled = _loops.Count(l => l.Verdict == LoopVerdict.Stalled);

        _suspendedContainers = LogMonitor.SuspendedContainers();
        _exclusions = Exclusions.Current();
        _notRead = SelfStatusPresenter.UnreadContainers(
            _suspendedContainers, _exclusions, id => names.GetValueOrDefault(id, id), DateTime.UtcNow);
    }

    /// <summary>Reads the timeline sources. Unlike the rest of this page these are database queries, so they
    /// are refreshed on load and on demand rather than every five seconds — a status page that polls the
    /// database twelve times a minute is load of its own.</summary>
    private async Task RefreshTimelineAsync()
    {
        try
        {
            var since = DateTime.UtcNow - TimelineWindow;
            // R1-23: audit rows are Admin-only; other roles see the alerts on the timeline.
            var audit = _isAdmin ? await AuditLog.GetRecentAsync(count: 200) : [];
            var alerts = await Alerts.QueryAsync(severity: null, eventType: null, skip: 0, take: 200);

            _timeline = ActionTimeline.Build(audit, alerts, serverId: null, sinceUtc: since);

            // Plan-0006 WP5.1/5.3. Seven days rather than the timeline's six hours: a hit rate needs enough
            // outcomes to mean anything, and most action kinds fire far less often than once an hour.
            _outcomeRows = OutcomePresenter.Rows(await Outcomes.TalliesAsync(DateTime.UtcNow.AddDays(-7)));
            _overdueWarning = OutcomePresenter.OverdueWarning(await Outcomes.OverdueCountAsync(DateTime.UtcNow));
        }
        catch
        {
            // The timeline is context, not a check. If the database is unhappy the rest of this page — which
            // reads process memory and is exactly what you need when things are going wrong — must still render.
            _timeline = Array.Empty<TimelineEntry>();
            _outcomeRows = Array.Empty<OutcomeRow>();
            _overdueWarning = "";
        }
    }

    private bool _timelineLoading;

    /// <summary>The on-demand path the page header promises: re-reads the timeline and outcome sections.</summary>
    private async Task RefreshTimelineOnDemandAsync()
    {
        if (_timelineLoading) return;
        _timelineLoading = true;
        try { await RefreshTimelineAsync(); }
        finally { _timelineLoading = false; }
    }

    /// <summary>The one place a UTC instant becomes a local one. Everything upstream stays UTC (Plan-0003 WP5.2).</summary>
    private static string Local(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.Local)
            .ToString("HH:mm:ss");

    private string ServerName(string serverId) =>
        ServerConfig.GetServer(serverId)?.Name ?? serverId;

    private static Color ColourFor(LoopVerdict verdict) => verdict switch
    {
        LoopVerdict.Stalled => Color.Error,
        LoopVerdict.Skipped => Color.Info,
        LoopVerdict.Unjudged => Color.Default,
        _ => Color.Success
    };

    private static string LabelFor(LoopRow row) => row.Verdict switch
    {
        LoopVerdict.Stalled => "stalled",
        LoopVerdict.Skipped => $"skipped — {row.SkipReason}",
        LoopVerdict.Unjudged => "unjudged",
        _ => "ok"
    };

    public void Dispose() => _timer?.Dispose();
}
