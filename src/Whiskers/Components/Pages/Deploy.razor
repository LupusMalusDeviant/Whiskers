@page "/deploy"
@attribute [Authorize]
@inject Whiskers.Services.ServerConfig.IServerConfigService ServerConfigService
@inject ISnackbar Snackbar
@inject Whiskers.Services.Auth.ICurrentUserService CurrentUser
@inject IUiMutationRunner Mutations
@inject IDockerService DockerService
@inject IHostCommandExecutor Executor
@inject IComposePlanner ComposePlanner
@inject IComposeRunner ComposeRunner
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Deploy_PageTitle"]</PageTitle>

@* RoadToSAP Phase 1: gated by the Deployment module; when off, ModuleGuard shows a "disabled" notice.
   Contract 0013 (U1): both tabs deploy a real compose project through ComposePlan / ComposeRunner. *@
<ModuleGuard ModuleId="deployment">

<div class="sw-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div class="sw-page-icon">
            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Size="Size.Large" />
        </div>
        <div>
            <MudText Typo="Typo.h5">@L["Deploy_Header_Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Deploy_Header_Subtitle"]</MudText>
        </div>
    </MudStack>
</div>

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@L["Deploy_Hint_ComposeProjects"]</MudText>

@* Server Selection (applies to both tabs) *@
<MudSelect T="string" @bind-Value="_serverId" Label="@L["Deploy_Label_TargetServer"]" Variant="Variant.Outlined" Class="mb-4" Style="max-width: 320px;">
    @foreach (var srv in _servers)
    {
        <MudSelectItem Value="@srv.Id">@srv.Name</MudSelectItem>
    }
</MudSelect>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
    @* Tab 1: Form Deploy *@
    <MudTabPanel Text="@L["Deploy_Tab_Form"]" Icon="@Icons.Material.Filled.EditNote">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_formRequest.Image" Label="@L["Deploy_Label_ImageName"]" Variant="Variant.Outlined"
                              Placeholder="nginx:latest" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_formRequest.ContainerName" Label="@L["Deploy_Label_ContainerName"]"
                              Variant="Variant.Outlined" Placeholder="my-container" />
            </MudItem>

            @* Port Mappings *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Deploy_Section_PortMappings"]</MudText>
                @for (var i = 0; i < _ports.Count; i++)
                {
                    var idx = i;
                    <MudStack Row="true" Class="mb-2">
                        <MudTextField @bind-Value="_ports[idx].Host" Label="@L["Deploy_Label_HostPort"]" Variant="Variant.Outlined"
                                      Style="max-width: 150px;" />
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="align-self-center" />
                        <MudTextField @bind-Value="_ports[idx].Container" Label="@L["Deploy_Label_ContainerPort"]" Variant="Variant.Outlined"
                                      Style="max-width: 150px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _ports.RemoveAt(idx))" Class="align-self-center" />
                    </MudStack>
                }
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick="@(() => _ports.Add(new PortEntry()))">@L["Deploy_Button_AddPort"]</MudButton>
            </MudItem>

            @* Volumes *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Deploy_Section_Volumes"]</MudText>
                @for (var i = 0; i < _volumes.Count; i++)
                {
                    var idx = i;
                    <MudStack Row="true" Class="mb-2">
                        <MudTextField @bind-Value="_volumes[idx]" Label="host:container" Variant="Variant.Outlined"
                                      Placeholder="/data:/app/data" />
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _volumes.RemoveAt(idx))" Class="align-self-center" />
                    </MudStack>
                }
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick="@(() => _volumes.Add(""))">@L["Deploy_Button_AddVolume"]</MudButton>
            </MudItem>

            @* Environment Variables *@
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Deploy_Section_EnvVars"]</MudText>
                @for (var i = 0; i < _envVars.Count; i++)
                {
                    var idx = i;
                    <MudStack Row="true" Class="mb-2">
                        <MudTextField @bind-Value="_envVars[idx].Key" Label="Key" Variant="Variant.Outlined"
                                      Style="max-width: 200px;" />
                        <MudTextField @bind-Value="_envVars[idx].Value" Label="Value" Variant="Variant.Outlined" />
                        <MudIconButton Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _envVars.RemoveAt(idx))" Class="align-self-center" />
                    </MudStack>
                }
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick="@(() => _envVars.Add(new EnvEntry()))">@L["Deploy_Button_AddEnvVar"]</MudButton>
            </MudItem>

            @* Options *@
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_formRequest.RestartPolicy" Label="@L["Deploy_Label_RestartPolicy"]"
                           Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("unless-stopped")">@L["Deploy_RestartPolicy_UnlessStopped"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("always")">@L["Deploy_RestartPolicy_Always"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("on-failure")">@L["Deploy_RestartPolicy_OnFailure"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@("no")">@L["Deploy_RestartPolicy_No"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_formRequest.NetworkName" Label="@L["Deploy_Label_Network"]"
                              Variant="Variant.Outlined" Placeholder="bridge" />
            </MudItem>

            <MudItem xs="12">
                @if (_role >= AppRole.Operator)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DeployFromForm"
                               Disabled="_deploying" StartIcon="@Icons.Material.Filled.RocketLaunch">
                        @if (_deploying) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        @L["Deploy_Button_Deploy"]
                    </MudButton>
                }
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_deployProgress))
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">@_deployProgress</MudAlert>
        }
    </MudTabPanel>

    @* Tab 2: Compose Deploy — the compose editor's path (contract 0013, D2) *@
    <MudTabPanel Text="Compose" Icon="@Icons.Material.Filled.Description">
        <MudTextField @bind-Value="_projectName" Label="@L["Deploy_Label_ProjectName"]" Variant="Variant.Outlined"
                      Placeholder="my-app" Class="mb-3" Style="max-width: 320px;" />
        <MudTextField @bind-Value="_composeYaml" @bind-Value:after="SuggestProjectName" Label="docker-compose.yml"
                      Variant="Variant.Outlined" Lines="15" Placeholder="@L["Deploy_Placeholder_ComposeContent"]"
                      Style="font-family: 'Cascadia Code', monospace; font-size: 13px;" />

        <MudStack Row="true" Class="mt-4">
            <MudButton Variant="Variant.Outlined" OnClick="CheckPlan" Disabled="@(_checking || string.IsNullOrWhiteSpace(_composeYaml))"
                       StartIcon="@Icons.Material.Filled.CheckCircle">
                @L["Deploy_Button_Validate"]
            </MudButton>
            @if (_role >= AppRole.Operator)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DeployFromCompose"
                           Disabled="@(_deploying || string.IsNullOrWhiteSpace(_composeYaml))"
                           StartIcon="@Icons.Material.Filled.RocketLaunch">
                    @if (_deploying) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    @L["Deploy_Button_DeployAll"]
                </MudButton>
            }
        </MudStack>

        @if (_planError != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @L["Deploy_Validation_ErrorsTitle"] @_planError
            </MudAlert>
        }
        else if (_checkedPlan != null)
        {
            <MudPaper Class="pa-4 mt-4" Elevation="1">
                <MudAlert Severity="Severity.Success">
                    @L["Deploy_Validation_Valid", _checkedPlan.ProjectNameForAudit, _checkedPlan.ProjectDirectory, _checkedPlan.ActiveServices.Count]
                    @string.Join(", ", _checkedPlan.ActiveServices.Select(s => s.Name))
                </MudAlert>
                @if (_checkedPlan.Impact.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">@L["Deploy_Plan_Touches"]</MudText>
                    <ul class="deploy-plan-touches">
                        @foreach (var i in _checkedPlan.Impact)
                        {
                            <li>@i.Container.Name (@i.Kind)</li>
                        }
                    </ul>
                }
                @if (_checkedPlan.Exposures().Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">@L["Deploy_Plan_Exposures"]</MudText>
                    <ul class="deploy-plan-exposures">
                        @foreach (var e in _checkedPlan.Exposures())
                        {
                            <li>@e.Display — @ExposureClasses.Of(e.Kind, e.Key, _checkedPlan.ExposurePrefixes)</li>
                        }
                    </ul>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mt-3">@L["Deploy_Plan_NoExposures"]</MudText>
                }
            </MudPaper>
        }

        @if (!string.IsNullOrEmpty(_deployProgress))
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">@_deployProgress</MudAlert>
        }
    </MudTabPanel>
</MudTabs>

</ModuleGuard>

@code {
    private DeploymentRequest _formRequest = new() { RestartPolicy = "unless-stopped" };
    private List<PortEntry> _ports = new();
    private List<string> _volumes = new();
    private List<EnvEntry> _envVars = new();
    private string _composeYaml = string.Empty;
    private string _projectName = string.Empty;
    private ComposePlan? _checkedPlan;
    private string? _planError;
    private bool _checking;
    private bool _deploying;
    private string _deployProgress = string.Empty;
    private AppRole _role = AppRole.Viewer;
    private List<Whiskers.Models.ServerConfig> _servers = new();
    private string _serverId = "local";

    /// <summary>The role check in front of a mutation: a refusal is also the gateway's Denied event for
    /// <paramref name="capabilityId"/> on <paramref name="arguments"/>, so the attempt is on record once (R1-21).</summary>
    private async Task<bool> RequireAsync(string capabilityId, object arguments)
    {
        // The role comes from the capability catalog, the one level table (INV-13), never from the page.
        var required = CapabilityCatalog.RoleOf(capabilityId);
        if (_role >= required) return true;
        Snackbar.Add(L["Deploy_Snackbar_NoPermission", required, _role].Value, Severity.Warning);
        await Mutations.RefuseAsync(capabilityId, arguments, $"Requires the {required} role.");
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _role = await CurrentUser.GetRoleAsync();
        _servers = ServerConfigService.GetEnabledServers()
            .Where(s => s.ConnectionType != Whiskers.Models.ConnectionType.Kubernetes) // compose = Docker hosts only
            .ToList();
        _serverId = ServerConfigService.GetDefaultServer()?.Id ?? "local";
    }

    /// <summary>The planner of a tab (contract 0013, D3/D15): the project's directory and names must be free.</summary>
    private IComposePlanner PlannerFor(DeploymentPath path) => new DeploymentPathPlanner(ComposePlanner, DockerService, Executor, path);

    private IProgress<string> Progress() => new Progress<string>(msg =>
    {
        _deployProgress = msg;
        InvokeAsync(StateHasChanged);
    });

    private async Task DeployFromForm()
    {
        // Deploy = root on the host (bind mounts, privileged); same level as the MCP deploy tools.
        if (!await RequireAsync("app.deploy", new { serverId = _serverId, image = _formRequest.Image })) return;
        if (string.IsNullOrWhiteSpace(_formRequest.Image))
        {
            Snackbar.Add(L["Deploy_Snackbar_ImageRequired"].Value, Severity.Warning);
            return;
        }

        var ports = _ports.Where(p => !string.IsNullOrWhiteSpace(p.Host) && !string.IsNullOrWhiteSpace(p.Container)).ToList();
        var envs = _envVars.Where(e => !string.IsNullOrWhiteSpace(e.Key)).ToList();
        // ToDictionary throws on a duplicate — tell the user which entry is doubled instead.
        var dup = ports.GroupBy(p => p.Host.Trim()).FirstOrDefault(g => g.Count() > 1)?.Key
               ?? envs.GroupBy(e => e.Key.Trim()).FirstOrDefault(g => g.Count() > 1)?.Key;
        if (dup != null)
        {
            Snackbar.Add(L["Deploy_Snackbar_Duplicate", dup].Value, Severity.Warning);
            return;
        }
        var request = new DeploymentRequest
        {
            Image = _formRequest.Image.Trim(),
            ContainerName = _formRequest.ContainerName,
            RestartPolicy = _formRequest.RestartPolicy,
            NetworkName = _formRequest.NetworkName,
            PortMappings = ports.ToDictionary(p => p.Host.Trim(), p => p.Container.Trim()),
            Volumes = _volumes.Where(v => !string.IsNullOrWhiteSpace(v)).ToList(),
            EnvironmentVars = envs.ToDictionary(e => e.Key.Trim(), e => e.Value ?? ""),
        };

        // Contract 0013, D1: the one mapper — the file the decision sees is the file that runs.
        DeploymentComposeFile file;
        try
        {
            file = DeploymentCompose.ToCompose(request);
        }
        catch (DeploymentComposeException ex)
        {
            Snackbar.Add(L["Deploy_Snackbar_Refused", ex.Message].Value, Severity.Warning);
            return;
        }

        var sid = _serverId;
        await RunAsync(DeploymentPath.AppDeploy, "app.deploy",
            new { serverId = sid, appName = file.Name, image = request.Image, volumes = string.Join(",", request.Volumes) },
            file.Deployment(sid), "Deploy_Snackbar_Deployed", "Deploy_Progress_Success");
    }

    private async Task DeployFromCompose()
    {
        // Deploy = root on the host (bind mounts, privileged); same level as the MCP deploy tools.
        if (!await RequireAsync("compose.deploy", new { projectName = _projectName, serverId = _serverId })) return;
        SuggestProjectName();
        if (!McpInputValidationName(_projectName))
        {
            Snackbar.Add(L["Deploy_Snackbar_InvalidProjectName"].Value, Severity.Warning);
            return;
        }
        var sid = _serverId;
        // Contract 0013, D2: exactly the compose editor's path — the file is planned, its mounts, exposures and the
        // containers it touches are decided, and it runs through the compose runner.
        await RunAsync(DeploymentPath.ComposeTab, "compose.deploy", new { projectName = _projectName, serverId = sid },
            ComposeDeployment.FromContent(sid, ComposeDeployment.DeploymentDirectory(_projectName), _composeYaml),
            "Deploy_Snackbar_ComposeDeployed", "Deploy_Progress_ComposeSuccess");
    }

    private async Task RunAsync(DeploymentPath path, string capabilityId, object arguments, ComposeDeployment deployment,
        string deployedKey, string progressKey)
    {
        _deploying = true;
        _deployProgress = "";
        try
        {
            var deployed = await Mutations.RunDeploymentAsync(Executor, PlannerFor(path), ComposeRunner, capabilityId, arguments,
                deployment, progress: Progress());
            var plan = deployed.Plan;
            var run = deployed.Run;
            if (run.Success)
            {
                var names = string.Join(", ", plan.ActiveServices.Select(s => s.ContainerName ?? $"{plan.ProjectName}-{s.Name}-1"));
                Snackbar.Add(L[deployedKey, plan.ProjectNameForAudit, names].Value, Severity.Success);
                _deployProgress = L[progressKey, plan.ProjectNameForAudit, names].Value;
            }
            else if (run.Refusal is { } refusal)
            {
                // D4: refused before up — nothing started; a warning naming service, kind and key only.
                Snackbar.Add(L["Deploy_Snackbar_Refused", refusal].Value, Severity.Warning);
                _deployProgress = L["Deploy_Snackbar_Refused", refusal].Value;
            }
            else if (run.Violations.Count > 0)
            {
                var violations = string.Join("; ", run.Violations);
                Snackbar.Add(L["Deploy_Snackbar_Violations", violations].Value, Severity.Error);
                _deployProgress = L["Deploy_Snackbar_Violations", violations].Value;
            }
            else
            {
                Snackbar.Add(L["Deploy_Snackbar_DeployFailed", run.Error].Value, Severity.Error);
                _deployProgress = L["Deploy_Progress_Error", run.Error].Value;
            }
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (ComposePlanException ex)
        {
            // D3 / D15 and every other plan refusal: before anything is written.
            Snackbar.Add(L["Deploy_Snackbar_Refused", ex.Message].Value, Severity.Warning);
            _deployProgress = L["Deploy_Snackbar_Refused", ex.Message].Value;
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Deploy_Snackbar_DeployFailed", ex.Message].Value, Severity.Error);
            _deployProgress = L["Deploy_Progress_Error", ex.Message].Value;
        }
        finally
        {
            _deploying = false;
        }
    }

    /// <summary>"Check plan" (D2): the read-only plan of the compose tab — project, services, the existing containers it
    /// touches and every exposure with its class.</summary>
    private async Task CheckPlan()
    {
        _checkedPlan = null;
        _planError = null;
        SuggestProjectName();
        if (!McpInputValidationName(_projectName))
        {
            _planError = L["Deploy_Snackbar_InvalidProjectName"].Value;
            return;
        }
        _checking = true;
        try
        {
            _checkedPlan = await PlannerFor(DeploymentPath.ComposeTab).PlanAsync(
                ComposeDeployment.FromContent(_serverId, ComposeDeployment.DeploymentDirectory(_projectName), _composeYaml));
        }
        catch (ComposePlanException ex)
        {
            _planError = ex.Message;
        }
        catch (Exception ex)
        {
            _planError = ex.Message;
        }
        finally
        {
            _checking = false;
        }
    }

    private static bool McpInputValidationName(string name) => Whiskers.Mcp.Tools.McpInputValidation.IsSafeProjectName(name);

    /// <summary>D2: the project name is pre-filled from a top-level <c>name:</c> or the first service, while empty.</summary>
    private void SuggestProjectName()
    {
        if (!string.IsNullOrWhiteSpace(_projectName) || string.IsNullOrWhiteSpace(_composeYaml)) return;
        try
        {
            var stream = new YamlDotNet.RepresentationModel.YamlStream();
            stream.Load(new StringReader(_composeYaml));
            if (stream.Documents.FirstOrDefault()?.RootNode is not YamlDotNet.RepresentationModel.YamlMappingNode root) return;
            string? Scalar(YamlDotNet.RepresentationModel.YamlNode? node) => (node as YamlDotNet.RepresentationModel.YamlScalarNode)?.Value;
            var name = root.Children.TryGetValue(new YamlDotNet.RepresentationModel.YamlScalarNode("name"), out var n) ? Scalar(n) : null;
            if (string.IsNullOrWhiteSpace(name) && root.Children.TryGetValue(new YamlDotNet.RepresentationModel.YamlScalarNode("services"), out var s)
                && s is YamlDotNet.RepresentationModel.YamlMappingNode services)
                name = Scalar(services.Children.Keys.FirstOrDefault());
            if (!string.IsNullOrWhiteSpace(name) && !name.Contains('$')) _projectName = name;
        }
        catch (YamlDotNet.Core.YamlException)
        {
            // Not YAML yet: the field stays empty; the plan will say why.
        }
    }

    private class PortEntry
    {
        public string Host { get; set; } = "";
        public string Container { get; set; } = "";
    }

    private class EnvEntry
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
    }
}
