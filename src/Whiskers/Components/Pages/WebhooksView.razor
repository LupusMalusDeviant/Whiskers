@inject Whiskers.Services.Webhooks.IWebhookService WebhookService
@inject Whiskers.Services.GitDeploy.IGitDeployService GitDeploy
@inject IDockerService DockerService
@inject Whiskers.Services.ServerConfig.IServerConfigService ServerConfigService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Whiskers.Services.Auth.ICurrentUserService CurrentUser
@inject IUiMutationRunner Mutations
@inject IComposePlanner ComposePlanner
@inject IAutomationOwnerResolver OwnerResolver
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

@* The interactive webhooks UI. Rendered by Webhooks.razor only when the Webhooks module is enabled (via
   ModuleGuard), so a disabled module never reaches the IWebhookService injection. *@

<div class="sw-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div class="sw-page-icon">
            <MudIcon Icon="@Icons.Material.Filled.Webhook" Size="Size.Large" />
        </div>
        <div>
            <MudText Typo="Typo.h5">@L["WebhooksView_Header_Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["WebhooksView_Header_Subtitle"]</MudText>
        </div>
        <MudSpacer />
        @if (_role >= AppRole.Admin)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ShowCreateDialog">@L["WebhooksView_Button_Create"]</MudButton>
        }
    </MudStack>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    @L["WebhooksView_Alert_Intro"]
</MudAlert>

@if (!_webhooks.Any())
{
    <MudAlert Severity="Severity.Info">@L["WebhooksView_Empty_NoWebhooks"]</MudAlert>
}
else
{
    <MudTable Items="@_webhooks" Dense="true" Hover="true" Striped="true" Elevation="0">
        <HeaderContent>
            <MudTh>@L["WebhooksView_Table_Name"]</MudTh>
            <MudTh>@L["WebhooksView_Table_Status"]</MudTh>
            <MudTh>@L["WebhooksView_Table_Url"]</MudTh>
            <MudTh>@L["WebhooksView_Table_Action"]</MudTh>
            <MudTh>@L["WebhooksView_Table_Target"]</MudTh>
            <MudTh>@L["WebhooksView_Table_Owner"]</MudTh>
            <MudTh>@L["WebhooksView_Table_Triggered"]</MudTh>
            <MudTh>@L["WebhooksView_Table_Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><strong>@context.Name</strong></MudTd>
            <MudTd>
                @if (string.IsNullOrEmpty(context.Secret))
                {
                    <MudTooltip Text="@L["WebhooksView_Tooltip_LegacyNoSecret"]">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                 Icon="@Icons.Material.Filled.Warning">@L["WebhooksView_Chip_NoSecret"]</MudChip>
                    </MudTooltip>
                }
                else if (context.Enabled)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@L["WebhooksView_Chip_Active"]</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@L["WebhooksView_Chip_Disabled"]</MudChip>
                }
            </MudTd>
            <MudTd>
                <code style="font-size: 0.75rem; word-break: break-all;">
                    @($"{Nav.BaseUri}api/webhooks/{context.WebhookId}")
                </code>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetActionColor(context.Action)" Variant="Variant.Outlined">@context.Action</MudChip>
                <MudText Typo="Typo.caption" title="@L[$"WebhooksView_Provider_Hint_{context.Provider}"]">@L[$"WebhooksView_Provider_{context.Provider}"]</MudText>
            </MudTd>
            <MudTd><code>@context.TargetId</code></MudTd>
            <MudTd>
                @if (string.IsNullOrWhiteSpace(context.Owner))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["WebhooksView_Chip_NoOwner"]</MudChip>
                }
                else
                {
                    var owner = OwnerResolver.Describe(context.Owner);
                    <MudText Typo="Typo.body2">@owner.Name</MudText>
                    @if (owner.State != OwnerState.Active)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@L[$"AutomationOwners_State_{owner.State}"]</MudText>
                    }
                }
                @if (_role >= AppRole.Admin && _me is not null && context.Owner != _me)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small"
                                   OnClick="@(() => AdoptWebhook(context))" title="@L["WebhooksView_Tooltip_Adopt"]" />
                }
            </MudTd>
            <MudTd>@context.TriggerCount×</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => TestWebhook(context))" title="@L["WebhooksView_Tooltip_SendSignedTest"]" />
                @if (_role >= AppRole.Admin)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Color="Color.Warning" Size="Size.Small"
                                   OnClick="@(() => RegenerateSecret(context))" title="@L["WebhooksView_Tooltip_RegenerateSecret"]" />
                    <MudIconButton Icon="@(context.Enabled ? Icons.Material.Filled.PauseCircle : Icons.Material.Filled.PlayCircle)"
                                   Color="@(context.Enabled ? Color.Default : Color.Success)" Size="Size.Small"
                                   OnClick="@(() => ToggleEnabled(context))"
                                   title="@(context.Enabled ? L["WebhooksView_Tooltip_Disable"].Value : L["WebhooksView_Tooltip_Enable"].Value)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteWebhook(context))" title="@L["WebhooksView_Tooltip_Delete"]" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* One-time secret display (create + regenerate). The secret is shown exactly once and never again. *@
<MudDialog Visible="_showSecretDialog" VisibleChanged="@(v => { _showSecretDialog = v; if (!v) _shownSecret = null; })"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false })">
    <TitleContent>@L["WebhooksView_SecretDialog_Title"]</TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            @((MarkupString)L["WebhooksView_SecretDialog_Warning"].Value)
        </MudAlert>
        <MudTextField Value="@_shownSecretUrl" Label="@L["WebhooksView_SecretDialog_UrlLabel"]" Variant="Variant.Outlined" ReadOnly="true"
                      Class="mb-3" Style="font-family: 'JetBrains Mono', monospace;"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="@(() => CopyToClipboard(_shownSecretUrl))" />
        <MudTextField Value="@_shownSecret" Label="@L["WebhooksView_SecretDialog_SecretLabel"]" Variant="Variant.Outlined" ReadOnly="true"
                      Style="font-family: 'JetBrains Mono', monospace;"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      OnAdornmentClick="@(() => CopyToClipboard(_shownSecret))" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => { _showSecretDialog = false; _shownSecret = null; })">@L["WebhooksView_SecretDialog_CloseButton"]</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog Visible="_showDialog" VisibleChanged="@(v => _showDialog = v)" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>@L["WebhooksView_Dialog_CreateTitle"]</TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_formName" Label="@L["WebhooksView_Field_Name"]" Variant="Variant.Outlined" Class="mb-3" />
            <MudSelect T="string" Value="_formServerId" ValueChanged="OnWebhookServerChanged" Label="@L["WebhooksView_Field_TargetServer"]" Variant="Variant.Outlined" Class="mb-3">
                @foreach (var srv in _servers)
                {
                    <MudSelectItem Value="@srv.Id">@srv.Name</MudSelectItem>
                }
            </MudSelect>
            @* R1-10: how deliveries are signed; the hint says what a sender must do and what replay protection it gives. *@
            <MudSelect T="string" @bind-Value="_formProvider" Label="@L["WebhooksView_Field_Provider"]" Variant="Variant.Outlined"
                       HelperText="@L[$"WebhooksView_Provider_Hint_{_formProvider}"]" Class="mb-3">
                <MudSelectItem Value="@Whiskers.Services.Webhooks.WebhookSignatures.GitHub">@L["WebhooksView_Provider_github"]</MudSelectItem>
                <MudSelectItem Value="@Whiskers.Services.Webhooks.WebhookSignatures.Whiskers">@L["WebhooksView_Provider_whiskers"]</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" Value="_formAction" ValueChanged="OnFormActionChanged" Label="@L["WebhooksView_Field_Action"]" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem Value="@("restart")">@L["WebhooksView_Action_Restart"]</MudSelectItem>
                <MudSelectItem Value="@("rebuild")">@L["WebhooksView_Action_Rebuild"]</MudSelectItem>
                <MudSelectItem Value="@("deploy")">@L["WebhooksView_Action_Deploy"]</MudSelectItem>
                <MudSelectItem Value="@("git-deploy")">@L["WebhooksView_Action_GitDeploy"]</MudSelectItem>
            </MudSelect>
            @if (_formAction == "git-deploy")
            {
                <MudSelect T="string" @bind-Value="_formTarget" Label="@L["WebhooksView_Field_GitDeployApp"]" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var app in _gitApps)
                    {
                        <MudSelectItem Value="@app.Id">@app.Name (@app.Branch)</MudSelectItem>
                    }
                </MudSelect>
                @if (!_gitApps.Any())
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        @L["WebhooksView_Alert_NoGitApps_Before"]<MudLink Href="git-deploy">@L["WebhooksView_Alert_NoGitApps_Link"]</MudLink>@L["WebhooksView_Alert_NoGitApps_After"]
                    </MudAlert>
                }
            }
            else if (_formAction is "restart" or "rebuild")
            {
                <MudSelect T="string" @bind-Value="_formTarget" Label="@L["WebhooksView_Field_Container"]" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var c in _containers)
                    {
                        <MudSelectItem Value="@c.Name">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField @bind-Value="_formTarget" Label="@L["WebhooksView_Field_ComposeDir"]" Variant="Variant.Outlined" Class="mb-3"
                              Placeholder="/opt/deployments/my-app" Style="font-family: 'JetBrains Mono', monospace;" />
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showDialog = false)">@L["WebhooksView_Button_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateWebhook"
                       Disabled="@(string.IsNullOrWhiteSpace(_formName) || string.IsNullOrWhiteSpace(_formTarget))">@L["WebhooksView_Button_CreateConfirm"]</MudButton>
        </DialogActions>
    </MudDialog>

@code {
    private List<Whiskers.Models.WebhookEntity> _webhooks = new();
    private List<Whiskers.Models.ContainerInfo> _containers = new();
    private bool _showDialog;
    private bool _showSecretDialog;
    private string? _shownSecret;
    private string _shownSecretUrl = "";
    private string _formName = "";
    private string _formAction = "restart";
    private string _formProvider = Whiskers.Services.Webhooks.WebhookSignatures.GitHub;
    private string _formTarget = "";
    private List<Whiskers.Models.ServerConfig> _servers = new();
    private string _formServerId = "local";
    private AppRole _role = AppRole.Viewer;
    // The signed-in person as a principal id: the owner of the webhooks they create or take over (R1-09).
    private string? _me;

    private bool Require(AppRole required)
    {
        if (_role < required)
        {
            Snackbar.Add(L["WebhooksView_Snackbar_NoPermission", required, _role].Value, Severity.Warning);
            return false;
        }
        return true;
    }

    /// <summary>The role check in front of a mutation: a refusal is also the gateway's Denied event for
    /// <paramref name="capabilityId"/> on <paramref name="arguments"/>, so the attempt is on record once (R1-22).</summary>
    private async Task<bool> RequireAsync(AppRole required, string capabilityId, object arguments)
    {
        if (Require(required)) return true;
        await Mutations.RefuseAsync(capabilityId, arguments, $"Requires the {required} role.");
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _role = await CurrentUser.GetRoleAsync();
        _me = await CurrentUser.GetEmailAsync() is { Length: > 0 } email ? PrincipalIds.User(email) : null;
        _servers = ServerConfigService.GetEnabledServers();
        _webhooks = await WebhookService.GetWebhooksAsync();
    }

    private List<Whiskers.Models.GitDeployApp> _gitApps = new();

    private async Task ShowCreateDialog()
    {
        _formName = ""; _formAction = "restart"; _formTarget = ""; _formProvider = Whiskers.Services.Webhooks.WebhookSignatures.GitHub;
        _formServerId = ServerConfigService.GetDefaultServer()?.Id ?? "local";
        await LoadContainersForServer();
        _gitApps = await GitDeploy.GetAppsAsync();   // empty when the GitDeploy module is off (no-op)
        _showDialog = true;
    }

    private async Task OnWebhookServerChanged(string serverId)
    {
        _formServerId = serverId;
        _formTarget = "";
        await LoadContainersForServer();
    }

    // The target means something different per action (container name / compose dir / git app id),
    // so a value picked for one action must not silently carry over to another.
    private void OnFormActionChanged(string action)
    {
        _formAction = action;
        _formTarget = "";
    }

    private async Task LoadContainersForServer()
    {
        var sid = _formServerId;
        // all: true — a stopped container is a legitimate restart/rebuild target too. The server-scoped
        // overload is used on purpose; ListAllContainersAsync spans the whole fleet.
        _containers = (await DockerService.ListContainersAsync(all: true, serverId: sid)).ToList();
    }

    private async Task CreateWebhook()
    {
        if (_me is null) return;
        if (!await RequireAsync(AppRole.Admin, "webhook.save",
                new { name = _formName, action = _formAction, target = _formTarget, serverId = _formServerId, provider = _formProvider })) return;
        try
        {
            // Decided by the gateway (R1-09); the creator becomes the owner an external call runs on. The secret is
            // generated by the service and never part of the decision's arguments.
            var owner = _me;
            var entity = new Whiskers.Models.WebhookEntity
            {
                Name = _formName,
                Action = _formAction,
                TargetType = _formAction == "deploy" ? "compose" : "container",
                TargetId = _formTarget,
                ServerId = _formServerId,
                Owner = owner,
                Provider = _formProvider,
            };
            var wh = await Mutations.RunAsync("webhook.save",
                new { name = entity.Name, action = entity.Action, target = entity.TargetId, serverId = entity.ServerId, owner,
                      provider = entity.Provider },
                async _ =>
                {
                    var created = await WebhookService.CreateWebhookAsync(entity);
                    // The new webhook's id is part of the gateway's event (R1-22); its secret never is.
                    MutationScope.Note($"Webhook {created.WebhookId}");
                    return created;
                });
            _showDialog = false;
            // One-time display: the secret is only ever available right here.
            ShowSecretOnce(wh.WebhookId, wh.Secret);
            _webhooks = await WebhookService.GetWebhooksAsync();
        }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add(L["WebhooksView_Snackbar_Error", ex.Message].Value, Severity.Error); }
    }

    /// <summary>Takes the webhook over (R1-09): an external call then runs on the authority of the admin taking it
    /// over — for a webhook saved before owners were recorded, the only way to make it run again.</summary>
    private async Task AdoptWebhook(Whiskers.Models.WebhookEntity wh)
    {
        if (_me is null) return;
        if (!await RequireAsync(AppRole.Admin, "webhook.save",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId, owner = _me })) return;
        try
        {
            var me = _me;
            var previous = wh.Owner;
            var adopted = await Mutations.RunAsync("webhook.save",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId, owner = me },
                async _ =>
                {
                    var changed = await WebhookService.SetOwnerAsync(wh.WebhookId, me, previous);
                    if (changed) MutationScope.Note($"Owner: previous={previous ?? "none"}; new={me}");
                    return changed;
                });
            if (!adopted)
            {
                Snackbar.Add(L["WebhooksView_Snackbar_Conflict", wh.Name].Value, Severity.Warning);
            }
            else
            {
                Snackbar.Add(L["WebhooksView_Snackbar_Adopted", wh.Name].Value, Severity.Success);
            }
        }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add(L["WebhooksView_Snackbar_Error", ex.Message].Value, Severity.Error); }
        _webhooks = await WebhookService.GetWebhooksAsync();
    }

    private async Task TestWebhook(Whiskers.Models.WebhookEntity wh)
    {
        // Triggering runs restart/rebuild/deploy on the host — gate it behind Operator so a Viewer
        // cannot fire host actions from the UI. A refusal is decided on the action the test would run (R1-22).
        if (!await RequireAsync(AppRole.Operator, TestCapabilityOf(wh),
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId })) return;
        Snackbar.Add(L["WebhooksView_Snackbar_Testing", wh.Name].Value, Severity.Info);
        bool success;
        string output;
        try
        {
            // Signed end-to-end test: same HMAC validation path as an external CI caller, but decided by the
            // gateway as the person clicking, for the action and target the webhook really has.
            (success, output) = await TestGatedAsync(wh);
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return;
        }
        Snackbar.Add(success ? L["WebhooksView_Snackbar_TestOk", output].Value : L["WebhooksView_Snackbar_Error", output].Value,
            success ? Severity.Success : Severity.Error);
        _webhooks = await WebhookService.GetWebhooksAsync();
    }

    /// <summary>The test fires the webhook's real action: restart, rebuild (recreate), compose deploy or git deploy.
    /// It is decided twice, explicitly: here as the clicking person, on the target and plan the trigger computes
    /// (<see cref="Whiskers.Services.Webhooks.WebhookTargets"/>, R1-07) — then the signed call runs exactly like an
    /// external one, on the webhook owner's authority (R1-09). An unknown action is decided as nothing and refused by
    /// the service itself.</summary>
    private async Task<(bool Success, string Output)> TestGatedAsync(Whiskers.Models.WebhookEntity wh)
    {
        // The same server and container the trigger resolves when it runs (R1-06).
        var serverId = Whiskers.Services.Webhooks.WebhookTargets.ServerOf(wh);
        async Task<(bool, string)> Fire()
        {
            var fired = await WebhookService.TriggerSignedTestAsync(wh.WebhookId);
            // The test and its answer are part of the decided action's event (R1-22).
            MutationScope.Note($"Webhook test {wh.WebhookId}", fired.Item1);
            return fired;
        }
        switch (wh.Action)
        {
            case "restart":
            case "rebuild":
            {
                var (container, _) = await Whiskers.Services.Webhooks.WebhookTargets.ContainerAsync(DockerService, wh);
                return await Mutations.RunAsync(wh.Action == "restart" ? "container.restart" : "container.update",
                    new { containerId = container?.Id ?? wh.TargetId, name = container?.Name ?? wh.TargetId, serverId },
                    _ => Fire());
            }
            case "deploy":
            {
                // The same plan the trigger computes again before it runs, and checks against these decisions.
                var (plan, error) = await Whiskers.Services.Webhooks.WebhookTargets.ComposePlanAsync(ComposePlanner, wh);
                if (plan is null) return (false, error!);   // nothing can be decided, so nothing runs
                return await Mutations.RunAsync("compose.deploy",
                    new { projectName = plan.ProjectNameForAudit, projectDir = plan.ProjectDirectory, serverId },
                    _ => Mutations.RunForEachAsync("compose.deploy", plan.Containers, serverId, Fire));
            }
            case "git-deploy":
            {
                // Decided as the clicking person on the stored app (its own server and revision); the trigger then
                // deploys it on the app owner's authority, deciding every planned container as that owner (R1-08).
                var app = await GitDeploy.GetAppAsync(wh.TargetId);
                if (app is null) return (false, "Git deploy app not found.");
                return await Mutations.RunAsync("gitdeploy.deploy",
                    new { appId = app.Id, name = app.Name, serverId = app.ServerId, revision = app.Revision }, _ => Fire());
            }
            default:
                return await Fire();
        }
    }

    private static string TestCapabilityOf(Whiskers.Models.WebhookEntity wh) => wh.Action switch
    {
        "restart" => "container.restart",
        "rebuild" => "container.update",
        "deploy" => "compose.deploy",
        "git-deploy" => "gitdeploy.deploy",
        _ => "webhook.save",
    };

    private async Task RegenerateSecret(Whiskers.Models.WebhookEntity wh)
    {
        if (!await RequireAsync(AppRole.Admin, "webhook.rotate_secret",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId })) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["WebhooksView_Dialog_RegenerateTitle"].Value,
            L["WebhooksView_Dialog_RegenerateMessage", wh.Name].Value,
            yesText: L["WebhooksView_Dialog_RegenerateConfirm"].Value, cancelText: L["WebhooksView_Dialog_Cancel"].Value);
        if (confirmed != true) return;
        try
        {
            // The new secret is the action's result for the one-time display, never an argument of the decision.
            var secret = await Mutations.RunAsync("webhook.rotate_secret",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId },
                _ => WebhookService.RegenerateSecretAsync(wh.WebhookId));
            ShowSecretOnce(wh.WebhookId, secret);
            _webhooks = await WebhookService.GetWebhooksAsync();
        }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add(L["WebhooksView_Snackbar_Error", ex.Message].Value, Severity.Error); }
    }

    private async Task ToggleEnabled(Whiskers.Models.WebhookEntity wh)
    {
        if (!await RequireAsync(AppRole.Admin, "webhook.set_enabled",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId, enabled = !wh.Enabled })) return;
        try
        {
            var enable = !wh.Enabled;
            await Mutations.RunAsync("webhook.set_enabled",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId, enabled = enable },
                _ => WebhookService.SetEnabledAsync(wh.WebhookId, enable));
            Snackbar.Add(wh.Enabled ? L["WebhooksView_Snackbar_Disabled"].Value : L["WebhooksView_Snackbar_Enabled"].Value, Severity.Success);
            _webhooks = await WebhookService.GetWebhooksAsync();
        }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add(L["WebhooksView_Snackbar_Error", ex.Message].Value, Severity.Error); }
    }

    private void ShowSecretOnce(string webhookId, string secret)
    {
        _shownSecret = secret;
        _shownSecretUrl = $"{Nav.BaseUri}api/webhooks/{webhookId}";
        _showSecretDialog = true;
    }

    private async Task CopyToClipboard(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        bool copied;
        try { copied = await JS.InvokeAsync<bool>("swClipboard.copy", text); }
        catch { copied = false; }
        if (copied) Snackbar.Add(L["WebhooksView_Snackbar_Copied"].Value, Severity.Success);
        else Snackbar.Add(L["Clipboard_CopyFailed_Manual"].Value, Severity.Warning);
    }

    private async Task DeleteWebhook(Whiskers.Models.WebhookEntity wh)
    {
        if (!await RequireAsync(AppRole.Admin, "webhook.delete",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId })) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["WebhooksView_Dialog_DeleteTitle"].Value,
            L["WebhooksView_Dialog_DeleteMessage", wh.Name].Value,
            yesText: L["WebhooksView_Dialog_DeleteConfirm"].Value, cancelText: L["WebhooksView_Dialog_Cancel"].Value);
        if (confirmed != true) return;
        try
        {
            await Mutations.RunAsync("webhook.delete",
                new { webhookId = wh.WebhookId, name = wh.Name, serverId = wh.ServerId },
                _ => WebhookService.DeleteWebhookAsync(wh.WebhookId));
            Snackbar.Add(L["WebhooksView_Snackbar_Deleted"].Value, Severity.Success);
            _webhooks = await WebhookService.GetWebhooksAsync();
        }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex)
        {
            Snackbar.Add(L["WebhooksView_Snackbar_Error", ex.Message].Value, Severity.Error);
        }
    }

    private static Color GetActionColor(string action) => action switch
    {
        "restart" => Color.Primary,
        "rebuild" => Color.Warning,
        "deploy" => Color.Tertiary,
        _ => Color.Default
    };
}
