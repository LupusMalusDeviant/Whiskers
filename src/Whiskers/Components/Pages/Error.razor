@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Error_PageTitle"]</PageTitle>

<h1 class="text-danger">@L["Error_Title"]</h1>
<h2 class="text-danger">@L["Error_Subtitle"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["Error_RequestId_Label"]</strong> <code>@RequestId</code>
    </p>
}

@* No advice to switch to the Development environment (review 1.0.0, T3): a deployed instance shows exception details
   to every visitor there. The request id above finds the error in the log. *@
<p>@L["Error_SeeLog"]</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
