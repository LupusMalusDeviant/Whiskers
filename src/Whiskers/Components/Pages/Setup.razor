@page "/setup"
@attribute [AllowAnonymous]
@layout Whiskers.Components.Layout.SetupLayout
@using System.Security.Cryptography
@using Whiskers.Services.Setup
@inject IConfiguration Config
@inject NavigationManager Nav
@inject ISetupStateService SetupState
@inject Whiskers.Services.Vault.IVaultService Vault
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityOpts
@inject Whiskers.Services.ServerConfig.IServerConfigService ServerConfig
@inject Whiskers.Services.Docker.IDockerConnectionManager ConnectionManager

<MudText Typo="Typo.overline" Color="Color.Secondary">@L["Setup_Step", _step + 1, 5]</MudText>
<MudProgressLinear Value="@((_step + 1) * 20)" Color="Color.Primary" Rounded="true" Class="mb-4" />

@* Step 0 — Welcome + language *@
@if (_step == 0)
{
    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_Welcome_Title"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">@L["Setup_Welcome_Body"]</MudText>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="set-culture?culture=en&redirect=/setup">English</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="set-culture?culture=de&redirect=/setup">Deutsch</MudButton>
    </div>
}
@* Step 1 — Admin account *@
else if (_step == 1)
{
    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_Admin_Title"]</MudText>
    <MudSwitch @bind-Value="_isLocal" Color="Color.Primary" Class="mb-2">@L["Setup_Admin_UseLocal"]</MudSwitch>
    <MudTextField @bind-Value="_email" Label="@L["Login_Field_Email"]" InputType="InputType.Email" Immediate="true" Class="mb-2" />
    @if (_isLocal)
    {
        <MudTextField @bind-Value="_password" Label="@L["Login_Field_Password"]" InputType="InputType.Password" Immediate="true"
                      HelperText="@L["Setup_Admin_PwHint"]" Class="mb-2"
                      Error="@(_password.Length > 0 && !PasswordMeetsPolicy)" ErrorText="@L["Setup_Admin_PwHint"]" />
        <MudTextField @bind-Value="_passwordConfirm" Label="@L["Setup_Admin_PwConfirm"]" InputType="InputType.Password" Immediate="true" />
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mt-2">@L["Setup_Admin_FederatedHint"]</MudText>
    }
    @if (_error != null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
}
@* Step 2 — Security basics (MCP key hint + VAULT_KEY) *@
else if (_step == 2)
{
    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_Security_Title"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-4 d-block">@L["Setup_Security_McpKeyHint"]</MudText>
    @if (_vaultEnabled)
    {
        <MudAlert Severity="Severity.Success" Dense="true">@L["Setup_Security_VaultOn"]</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.subtitle2">@L["Setup_Security_VaultKey"]</MudText>
        <MudTextField T="string" Value="_generatedVaultKey" ReadOnly="true" Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="@(() => Copy(_generatedVaultKey!))" Class="mb-1" />
        <MudText Typo="Typo.caption" Class="d-block">@L["Setup_Security_VaultKeyHint"]</MudText>
    }
    @if (_copied == true)
    {
        <MudText Typo="Typo.caption" Color="Color.Success" Class="d-block mt-2">@L["Clipboard_Copied"]</MudText>
    }
    else if (_copied == false)
    {
        <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-2">@L["Clipboard_CopyFailed_Manual"]</MudText>
    }
}
@* Step 3 — First server *@
else if (_step == 3)
{
    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_Server_Title"]</MudText>
    @if (_localDockerOk is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_localDockerOk == true)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@L["Setup_Server_LocalConnected"]</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@L["Setup_Server_LocalNotConnected"]</MudAlert>
    }
    <MudText Typo="Typo.body2">@L["Setup_Server_Body"]</MudText>
}
@* Step 4 — Done *@
else
{
    <MudText Typo="Typo.h6" Class="mb-2">@L["Setup_Done_Title"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">@L["Setup_Done_Body"]</MudText>
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Rocket">@L["Setup_Done_AiOps"]</MudAlert>
    @if (_error != null) { <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert> }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy" OnClick="CompleteAsync">
        @L["Setup_Done_Complete"]
    </MudButton>
}

<div class="d-flex justify-space-between mt-6">
    <MudButton Variant="Variant.Text" Disabled="@(_step == 0 || _busy)" OnClick="Back">@L["Setup_Back"]</MudButton>
    @if (_step < 4)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanNext)" OnClick="Next">@L["Setup_Next"]</MudButton>
    }
</div>

@code {
    private int _step;
    private bool _isLocal = true;
    private string _email = "";
    private string _password = "";
    private string _passwordConfirm = "";
    private bool _vaultEnabled;
    private string? _generatedVaultKey;
    private bool _busy;
    private string? _error;

    protected override void OnInitialized()
    {
        // Auth bypass / already-configured: the wizard has no purpose — go to the app.
        if (Config.GetValue<bool>("Auth:Disabled") || SetupState.IsSetupComplete)
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }

        _vaultEnabled = Vault.IsEnabled;
        if (!_vaultEnabled)
            _generatedVaultKey = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32));
    }

    private bool CanNext => _step switch
    {
        1 => !string.IsNullOrWhiteSpace(_email)
             && (!_isLocal || (PasswordMeetsPolicy && _password == _passwordConfirm)),
        _ => true
    };

    // Mirrors the Identity password policy, read from the same options Identity validates against. Checking only
    // the length let a password through this step that CompleteSetupAsync then rejected — on the last step, in
    // Identity's English wording.
    private bool PasswordMeetsPolicy
    {
        get
        {
            var p = IdentityOpts.Value.Password;
            return _password.Length >= p.RequiredLength
                // ASCII classes, exactly like Identity's PasswordValidator — char.IsUpper would count "Ä".
                && (!p.RequireDigit || _password.Any(char.IsAsciiDigit))
                && (!p.RequireLowercase || _password.Any(char.IsAsciiLetterLower))
                && (!p.RequireUppercase || _password.Any(char.IsAsciiLetterUpper))
                && (!p.RequireNonAlphanumeric || _password.Any(c => !char.IsAsciiLetterOrDigit(c)))
                && _password.Distinct().Count() >= p.RequiredUniqueChars;
        }
    }

    private async Task Next()
    {
        if (_step >= 4 || !CanNext) return;
        _step++;
        if (_step == 3) await ProbeLocalDockerAsync();
    }

    // Null = probe running; true/false = whether the local Docker host answered. The first-server
    // step used to claim "connected" unconditionally, even without a mounted socket.
    private bool? _localDockerOk;

    private async Task ProbeLocalDockerAsync()
    {
        _localDockerOk = null;
        StateHasChanged();
        try
        {
            // The default server, whatever its transport (socket, socket-proxy over TCP, ...).
            var local = ServerConfig.GetDefaultServer();
            if (local is null) { _localDockerOk = false; return; }

            // Cheapest real round-trip: list at most one running container, bounded by a timeout.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(5));
            var client = await ConnectionManager.GetClientAsync(local.Id).WaitAsync(cts.Token);
            await client.Containers.ListContainersAsync(
                new Docker.DotNet.Models.ContainersListParameters { Limit = 1 }, cts.Token);
            _localDockerOk = true;
        }
        catch
        {
            _localDockerOk = false;
        }
    }
    private void Back() { if (_step > 0) _step--; }

    // Null = nothing copied yet; true/false = what the last copy click did. The values are shown in read-only
    // fields, so a failed copy can be finished by hand — but only if the page says it failed.
    private bool? _copied;

    private async Task Copy(string value)
    {
        try { _copied = await JS.InvokeAsync<bool>("swClipboard.copy", value); }
        catch { _copied = false; }
    }

    private async Task CompleteAsync()
    {
        _busy = true; _error = null;
        SetupCompletionResult result;
        try
        {
            result = await SetupState.CompleteSetupAsync(new SetupAdminRequest
            {
                IsLocal = _isLocal,
                Email = _email.Trim(),
                Password = _isLocal ? _password : null
            });
        }
        catch (Exception ex)
        {
            // Unexpected failure (DB, Identity store, …): show it and re-enable the button instead of
            // leaving the wizard stuck in the busy state.
            _error = ex.Message;
            return;
        }
        finally
        {
            _busy = false;
        }

        if (result.Status == SetupCompletionStatus.Failed)
        {
            _error = string.Join(" ", result.Errors);
            _step = 1;   // back to the admin step to fix it
            return;
        }
        // Success (or someone just won the race): sign in via /login-local.
        Nav.NavigateTo("login", forceLoad: true);
    }
}
