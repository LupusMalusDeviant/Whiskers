@inject Whiskers.Services.GitDeploy.IGitDeployService GitDeploy
@inject Whiskers.Services.ServerConfig.IServerConfigService ServerConfigService
@inject Whiskers.Services.Vault.IVaultService Vault
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Whiskers.Services.Auth.ICurrentUserService CurrentUser
@inject IUiMutationRunner Mutations
@inject IAutomationOwnerResolver OwnerResolver
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<div class="sw-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div class="sw-page-icon">
            <MudIcon Icon="@Icons.Material.Filled.CloudSync" Size="Size.Large" />
        </div>
        <div>
            <MudText Typo="Typo.h5">@L["GitDeployView_Header_Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["GitDeployView_Header_Subtitle"]</MudText>
        </div>
        <MudSpacer />
        @if (_role >= AppRole.Admin)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => ShowEditDialog(null))">@L["GitDeployView_Button_AddApp"]</MudButton>
        }
    </MudStack>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    @((MarkupString)L["GitDeployView_Alert_Intro"].Value)
</MudAlert>

@if (!_apps.Any())
{
    <MudAlert Severity="Severity.Info">@L["GitDeployView_Empty_NoApps"]</MudAlert>
}
else
{
    <MudTable Items="@_apps" Dense="true" Hover="true" Striped="true" Elevation="0">
        <HeaderContent>
            <MudTh>@L["GitDeployView_Table_Name"]</MudTh>
            <MudTh>@L["GitDeployView_Table_Repository"]</MudTh>
            <MudTh>@L["GitDeployView_Table_Branch"]</MudTh>
            <MudTh>@L["GitDeployView_Table_Server"]</MudTh>
            <MudTh>@L["GitDeployView_Table_Owner"]</MudTh>
            <MudTh>@L["GitDeployView_Table_LastDeploy"]</MudTh>
            <MudTh>@L["GitDeployView_Table_Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><strong>@context.Name</strong></MudTd>
            <MudTd>
                <code style="font-size: 0.75rem;">@context.RepoUrl</code>
                @if (context.HasToken)
                {
                    <MudTooltip Text="@L["GitDeployView_Tooltip_PrivateRepo"]">
                        <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" Class="ml-1" Color="Color.Secondary" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Branch</MudChip></MudTd>
            <MudTd>@(ServerConfigService.GetServer(context.ServerId)?.Name ?? context.ServerId)</MudTd>
            <MudTd>
                @* Whose authority a webhook deploy runs on (R1-08): an app without one, or whose owner lost it, needs an admin. *@
                @if (string.IsNullOrWhiteSpace(context.Owner))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["GitDeployView_Chip_NoOwner"]</MudChip>
                }
                else
                {
                    var owner = OwnerResolver.Describe(context.Owner);
                    <MudText Typo="Typo.body2">@owner.Name</MudText>
                    @if (owner.State != OwnerState.Active)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@L[$"AutomationOwners_State_{owner.State}"]</MudText>
                    }
                }
                @if (_role >= AppRole.Admin && context.Owner != _me)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.PersonAddAlt" Size="Size.Small"
                                   OnClick="@(() => AdoptApp(context))" title="@L["GitDeployView_Tooltip_Adopt"]" />
                }
            </MudTd>
            <MudTd>
                @if (context.LastDeployedAt is { } t)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(context.LastDeploySucceeded == true ? Color.Success : Color.Error)">
                        @t.ToLocalTime().ToString("dd.MM. HH:mm") @(context.LastDeployedSha is { } s ? $"@ {s[..Math.Min(7, s.Length)]}" : "")
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GitDeployView_Text_Never"]</MudText>
                }
            </MudTd>
            <MudTd>
                @if (_role >= AppRole.Admin)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Primary" Size="Size.Small"
                                   OnClick="@(() => StartDeploy(context))" title="@L["GitDeployView_Tooltip_DeployNow"]" />
                }
                @if (_role >= AppRole.Admin)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   OnClick="@(() => ShowEditDialog(context))" title="@L["GitDeployView_Tooltip_Edit"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => DeleteApp(context))" title="@L["GitDeployView_Tooltip_Delete"]" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Add/edit dialog *@
<MudDialog Visible="_showDialog" VisibleChanged="@(v => _showDialog = v)"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>@(_editing == null ? L["GitDeployView_Dialog_AddTitle"].Value : L["GitDeployView_Dialog_EditTitle"].Value)</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="@L["GitDeployView_Field_Name"]" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_form.RepoUrl" Label="@L["GitDeployView_Field_RepoUrl"]" Variant="Variant.Outlined" Class="mb-3"
                      Placeholder="https://github.com/org/app.git" Style="font-family: 'JetBrains Mono', monospace;" />
        <MudTextField @bind-Value="_form.Branch" Label="@L["GitDeployView_Field_Branch"]" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_form.ComposePath" Label="@L["GitDeployView_Field_ComposePath"]" Variant="Variant.Outlined" Class="mb-3" />
        <MudSelect T="string" @bind-Value="_form.ServerId" Label="@L["GitDeployView_Field_TargetServer"]" Variant="Variant.Outlined" Class="mb-3">
            @foreach (var srv in _servers)
            {
                <MudSelectItem Value="@srv.Id">@srv.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="_formToken" Label="@L["GitDeployView_Field_AccessToken"]" Variant="Variant.Outlined"
                      InputType="InputType.Password" Class="mb-1"
                      HelperText="@(_editing?.HasToken == true ? L["GitDeployView_HelperText_TokenKeep"].Value : L["GitDeployView_HelperText_TokenNew"].Value)" />
        @if (!Vault.IsEnabled)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                @((MarkupString)L["GitDeployView_Alert_NoVault"].Value)
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDialog = false)">@L["GitDeployView_Button_Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveApp"
                   Disabled="@(string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.RepoUrl))">@L["GitDeployView_Button_Save"]</MudButton>
    </DialogActions>
</MudDialog>

@* Deploy log dialog (same pattern as the onboarding dialog) *@
<MudDialog Visible="_deploying" VisibleChanged="@(v => { if (!_deployBusy) _deploying = v; })"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>@L["GitDeployView_DeployDialog_Title", _deployApp?.Name ?? ""]</TitleContent>
    <DialogContent>
        <MudPaper Class="pa-3" Outlined="true" Style="max-height:55vh; overflow-y:auto; font-size:0.88rem;">
            @foreach (var line in _deployLog)
            {
                <div style="font-family:monospace; white-space:pre-wrap;">@line</div>
            }
            @if (_deployBusy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
            }
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { if (!_deployBusy) _deploying = false; })" Disabled="_deployBusy">
            @(_deployBusy ? L["GitDeployView_Button_Running"].Value : L["GitDeployView_Button_Close"].Value)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Whiskers.Models.GitDeployApp> _apps = new();
    private List<Whiskers.Models.ServerConfig> _servers = new();
    private AppRole _role = AppRole.Viewer;
    private string? _me;

    private bool _showDialog;
    private Whiskers.Models.GitDeployApp? _editing;
    private Whiskers.Models.GitDeployApp _form = new();
    private string _formToken = "";

    private bool _deploying;
    private bool _deployBusy;
    private List<string> _deployLog = new();
    private Whiskers.Models.GitDeployApp? _deployApp;

    private bool Require(AppRole required)
    {
        if (_role < required)
        {
            Snackbar.Add(L["GitDeployView_Snackbar_NoPermission", required, _role].Value, Severity.Warning);
            return false;
        }
        return true;
    }

    /// <summary>The role check in front of a mutation: a refusal is also the gateway's Denied event for
    /// <paramref name="capabilityId"/> on <paramref name="arguments"/>, so the attempt is on record once (R1-21).</summary>
    private async Task<bool> RequireAsync(AppRole required, string capabilityId, object arguments)
    {
        if (Require(required)) return true;
        await Mutations.RefuseAsync(capabilityId, arguments, $"Requires the {required} role.");
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _role = await CurrentUser.GetRoleAsync();
        _me = await CurrentUser.GetEmailAsync() is { Length: > 0 } email ? PrincipalIds.User(email) : null;
        _servers = ServerConfigService.GetEnabledServers()
            .Where(s => s.ConnectionType != Whiskers.Models.ConnectionType.Kubernetes) // compose = Docker hosts only
            .ToList();
        _apps = await GitDeploy.GetAppsAsync();
    }

    private void ShowEditDialog(Whiskers.Models.GitDeployApp? app)
    {
        _editing = app;
        // A copy, including the revision it was loaded at: a save over a newer revision is refused (R1-08).
        _form = app is null
            ? new Whiskers.Models.GitDeployApp { ServerId = ServerConfigService.GetDefaultServer()?.Id ?? "local" }
            : app.Clone();
        _formToken = "";
        _showDialog = true;
    }

    private async Task SaveApp()
    {
        if (!await RequireAsync(AppRole.Admin, "gitdeploy.save",
                new { appId = _editing is null ? null : _form.Id, name = _form.Name, serverId = _form.ServerId, branch = _form.Branch })) return;
        try
        {
            // Empty field = keep the existing token (null); a value = set it.
            var token = string.IsNullOrWhiteSpace(_formToken) ? null : _formToken;
            var form = _form;
            var appId = _editing is null ? null : form.Id;
            // Whoever saves the inputs owns the app: a webhook deploys them on that person's authority (R1-08).
            var owner = _me ?? throw new InvalidOperationException("No signed-in user.");
            await Mutations.RunAsync("gitdeploy.save",
                new { appId, name = form.Name, serverId = form.ServerId, branch = form.Branch, revision = form.Revision },
                async _ =>
                {
                    var saved = await GitDeploy.SaveAppAsync(form, token, owner);
                    // The saved app's id (new on create) is part of the gateway's event (R1-21).
                    MutationScope.Note($"App {saved.Id}");
                    return saved;
                });
            Snackbar.Add(L["GitDeployView_Snackbar_Saved", _form.Name].Value, Severity.Success);
            _showDialog = false;
            _apps = await GitDeploy.GetAppsAsync();
        }
        catch (MutationRefusedException ex)
        {
            // Among others, an app edited meanwhile (its revision moved): show the stored state.
            Snackbar.Add(ex.Message, Severity.Warning);
            _apps = await GitDeploy.GetAppsAsync();
        }
        catch (Whiskers.Services.GitDeploy.GitDeployConflictException)
        {
            Snackbar.Add(L["GitDeployView_Snackbar_Conflict", _form.Name].Value, Severity.Warning);
            _apps = await GitDeploy.GetAppsAsync();
        }
        catch (Exception ex) { Snackbar.Add(L["GitDeployView_Snackbar_Error", ex.Message].Value, Severity.Error); }
    }

    private async Task DeleteApp(Whiskers.Models.GitDeployApp app)
    {
        if (!await RequireAsync(AppRole.Admin, "gitdeploy.delete",
                new { appId = app.Id, name = app.Name, serverId = app.ServerId, branch = app.Branch })) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["GitDeployView_Dialog_DeleteTitle"].Value,
            L["GitDeployView_Dialog_DeleteMessage", app.Name].Value,
            yesText: L["GitDeployView_Dialog_DeleteConfirm"].Value, cancelText: L["GitDeployView_Dialog_Cancel"].Value);
        if (confirmed != true) return;
        try
        {
            await Mutations.RunAsync("gitdeploy.delete",
                new { appId = app.Id, name = app.Name, serverId = app.ServerId, branch = app.Branch, revision = app.Revision },
                _ => GitDeploy.DeleteAppAsync(app.Id));
            Snackbar.Add(L["GitDeployView_Snackbar_Deleted"].Value, Severity.Success);
            _apps = await GitDeploy.GetAppsAsync();
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(L["GitDeployView_Snackbar_Error", ex.Message].Value, Severity.Error); }
    }

    // A deploy clones and runs `docker compose up` as root on the host: root-equivalent, Admin (R1-05).
    private async Task StartDeploy(Whiskers.Models.GitDeployApp app)
    {
        if (!await RequireAsync(AppRole.Admin, "gitdeploy.deploy",
                new { appId = app.Id, name = app.Name, serverId = app.ServerId, branch = app.Branch })) return;
        _deployApp = app;
        _deployLog = new();
        _deploying = true;
        _deployBusy = true;
        StateHasChanged();

        var progress = new Progress<string>(msg => { _deployLog.Add(msg); InvokeAsync(StateHasChanged); });
        try
        {
            // The decision and the deployment use the same snapshot of the app (R1-08): an edit in between is refused.
            var snapshot = app.Clone();
            var (success, output) = await Mutations.RunAsync("gitdeploy.deploy",
                new { appId = snapshot.Id, name = snapshot.Name, serverId = snapshot.ServerId, branch = snapshot.Branch,
                      revision = snapshot.Revision },
                // Each existing container of the deployment's plan is decided too, before the first build (R1-07).
                async _ =>
                {
                    var deployed = await GitDeploy.DeployAsync(snapshot, Mutations.GateFor("gitdeploy.deploy"), progress);
                    // The deployment's output enriches the gateway's event (redacted there) — R1-21.
                    if (!string.IsNullOrWhiteSpace(deployed.Item2)) MutationScope.Note(deployed.Item2);
                    return deployed;
                });
        }
        catch (MutationRefusedException ex)
        {
            _deployLog.Add($"⚠ {ex.Message}");
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            _deployLog.Add($"❌ {ex.Message}");
        }
        finally
        {
            _deployBusy = false;
            _apps = await GitDeploy.GetAppsAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    // Taking an app over (R1-08): the admin's authority replaces the owner's for webhook deploys, only if nobody
    // changed the owner meanwhile.
    private async Task AdoptApp(Whiskers.Models.GitDeployApp app)
    {
        if (_me is null) return;
        if (!await RequireAsync(AppRole.Admin, "gitdeploy.save",
                new { appId = app.Id, name = app.Name, serverId = app.ServerId, branch = app.Branch, owner = _me })) return;
        try
        {
            var me = _me;
            var previous = app.Owner;
            var adopted = await Mutations.RunAsync("gitdeploy.save",
                new { appId = app.Id, name = app.Name, serverId = app.ServerId, branch = app.Branch,
                      revision = app.Revision, owner = me },
                async _ =>
                {
                    var changed = await GitDeploy.SetOwnerAsync(app.Id, me, previous);
                    if (changed) MutationScope.Note($"Owner: previous={previous ?? "none"}; new={me}");
                    return changed;
                });
            if (!adopted)
            {
                Snackbar.Add(L["GitDeployView_Snackbar_Conflict", app.Name].Value, Severity.Warning);
            }
            else
            {
                Snackbar.Add(L["GitDeployView_Snackbar_Adopted", app.Name].Value, Severity.Success);
            }
            _apps = await GitDeploy.GetAppsAsync();
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(L["GitDeployView_Snackbar_Error", ex.Message].Value, Severity.Error); }
    }
}
