@inject Whiskers.Services.Scheduler.ISchedulerService Scheduler
@inject IDockerService DockerService
@inject Whiskers.Services.ServerConfig.IServerConfigService ServerConfigService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Whiskers.Services.Auth.ICurrentUserService CurrentUser
@inject Whiskers.Services.AuditLog.IAuditLogService AuditLog
@inject IUiMutationRunner Mutations
@inject IAutomationOwnerResolver OwnerResolver
@inject IStringLocalizer<SharedResource> L
@inject Whiskers.Services.Mutations.ICapabilityCatalog Capabilities

@* The interactive scheduled-tasks UI. Rendered by ScheduledTasks.razor only when the Scheduler module is
   enabled (via ModuleGuard), so a disabled module never reaches the ISchedulerService injection. *@

<div class="sw-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <div class="sw-page-icon">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Large" />
        </div>
        <div>
            <MudText Typo="Typo.h5">@L["ScheduledTasksView_Header_Title"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ScheduledTasksView_Header_Subtitle"]</MudText>
        </div>
        <MudSpacer />
        @if (_role >= AppRole.Admin)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="ShowCreateDialog">@L["ScheduledTasksView_Button_CreateTask"]</MudButton>
        }
    </MudStack>
</div>

@* Stats Cards *@
<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <div class="sw-stat-card" style="text-align: center;">
            <div class="sw-stat-value" style="color: var(--sw-accent-blue);">@_tasks.Count</div>
            <div class="sw-stat-label">@L["ScheduledTasksView_Stat_Total"]</div>
        </div>
    </MudItem>
    <MudItem xs="6" sm="3">
        <div class="sw-stat-card" style="text-align: center;">
            <div class="sw-stat-value" style="color: var(--sw-accent-green);">@_tasks.Count(t => t.Enabled)</div>
            <div class="sw-stat-label">@L["ScheduledTasksView_Stat_Active"]</div>
        </div>
    </MudItem>
    <MudItem xs="6" sm="3">
        <div class="sw-stat-card" style="text-align: center;">
            <div class="sw-stat-value" style="color: var(--sw-accent-green);">@_tasks.Count(t => t.LastSuccess)</div>
            <div class="sw-stat-label">@L["ScheduledTasksView_Stat_LastRunOk"]</div>
        </div>
    </MudItem>
    <MudItem xs="6" sm="3">
        <div class="sw-stat-card" style="text-align: center;">
            <div class="sw-stat-value" style="color: var(--sw-accent-red);">@_tasks.Count(t => !t.LastSuccess && t.LastRun != null)</div>
            <div class="sw-stat-label">@L["ScheduledTasksView_Stat_Failed"]</div>
        </div>
    </MudItem>
</MudGrid>

@* Task List *@
@if (!_tasks.Any())
{
    <MudAlert Severity="Severity.Info">@L["ScheduledTasksView_Empty_NoTasks"]</MudAlert>
}
else
{
    @if (_tasks.Any(t => string.IsNullOrWhiteSpace(t.CreatedBy)))
    {
        @* PC-D6: tasks from before owners were recorded run in a grace period until an admin takes them over. *@
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            @L["ScheduledTasksView_Alert_Unowned", _tasks.Count(t => string.IsNullOrWhiteSpace(t.CreatedBy))]
            @if (_role >= AppRole.Admin)
            {
                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" Class="ml-2"
                           OnClick="AdoptAll">@L["ScheduledTasksView_Button_AdoptAll"]</MudButton>
            }
        </MudAlert>
    }
    @if (_tasks.Any(OwnerRevoked))
    {
        @* An owner who was removed, demoted to Viewer or whose key was deleted / disabled: every run is refused. *@
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @L["ScheduledTasksView_Alert_OwnerRevoked", _tasks.Count(OwnerRevoked)]
            @if (_role >= AppRole.Admin)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="ml-2"
                           OnClick="AdoptAll">@L["ScheduledTasksView_Button_AdoptAll"]</MudButton>
            }
        </MudAlert>
    }
    <MudTable Items="@_tasks" Dense="true" Hover="true" Striped="true" Elevation="0">
        <HeaderContent>
            <MudTh>@L["ScheduledTasksView_Table_Name"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_Type"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_Schedule"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_Target"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_Owner"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_NextRun"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_LastRun"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_Status"]</MudTh>
            <MudTh>@L["ScheduledTasksView_Table_Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><strong>@context.Name</strong></MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.TaskType)" Variant="Variant.Outlined">
                    @GetTypeLabel(context.TaskType)
                </MudChip>
            </MudTd>
            <MudTd><code>@context.CronExpression</code></MudTd>
            <MudTd><code>@(context.TargetName ?? context.TargetId ?? "-")</code></MudTd>
            <MudTd>
                @if (string.IsNullOrWhiteSpace(context.CreatedBy))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["ScheduledTasksView_Chip_NoOwner"]</MudChip>
                }
                else
                {
                    var owner = OwnerResolver.Describe(context.CreatedBy);
                    <MudText Typo="Typo.body2">@owner.Name</MudText>
                    @if (owner.State != OwnerState.Active)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@L[$"AutomationOwners_State_{owner.State}"]</MudText>
                    }
                    @if (OwnerRevoked(context))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@L["ScheduledTasksView_Chip_OwnerRevoked"]</MudChip>
                    }
                }
            </MudTd>
            <MudTd>
                @if (context.NextRun != null)
                {
                    <MudText Typo="Typo.body2">@context.NextRun.Value.ToLocalTime().ToString("dd.MM. HH:mm")</MudText>
                }
            </MudTd>
            <MudTd>
                @if (context.LastRun != null)
                {
                    <MudText Typo="Typo.body2">@context.LastRun.Value.ToLocalTime().ToString("dd.MM. HH:mm")</MudText>
                }
            </MudTd>
            <MudTd>
                @if (context.LastRun == null)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Style="color: var(--sw-text-muted);">@L["ScheduledTasksView_Chip_NeverRun"]</MudChip>
                }
                else if (context.LastSuccess)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                }
                else
                {
                    <MudTooltip Text="@context.LastResult">
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="0">
                    @if (_role >= RunNowRole(context))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => RunNow(context))" title="@L["ScheduledTasksView_Tooltip_RunNow"]" />
                    }
                    @if (_role >= AppRole.Admin)
                    {
                        @if (!IsMine(context.CreatedBy))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Warning" Size="Size.Small"
                                           OnClick="@(() => AdoptTask(context))" title="@L["ScheduledTasksView_Tooltip_Adopt"]" />
                        }
                        <MudSwitch T="bool" Value="@context.Enabled" Color="Color.Success" Size="Size.Small"
                                   ValueChanged="@((bool v) => ToggleEnabled(context, v))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => DeleteTask(context))" title="@L["ScheduledTasksView_Tooltip_Delete"]" />
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Run History *@
@if (_history.Any())
{
    <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2" Style="font-weight: 600;">@L["ScheduledTasksView_History_Title"]</MudText>
    <MudTable Items="@_history" Dense="true" Hover="true" Striped="true" Elevation="0">
        <HeaderContent>
            <MudTh>@L["ScheduledTasksView_History_Task"]</MudTh>
            <MudTh>@L["ScheduledTasksView_History_Type"]</MudTh>
            <MudTh>@L["ScheduledTasksView_History_Started"]</MudTh>
            <MudTh>@L["ScheduledTasksView_History_Duration"]</MudTh>
            <MudTh>@L["ScheduledTasksView_History_Result"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.TaskName</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@GetTypeLabel(context.TaskType)</MudChip></MudTd>
            <MudTd>@context.StartedAt.ToLocalTime().ToString("dd.MM. HH:mm:ss")</MudTd>
            <MudTd>@((context.CompletedAt ?? context.StartedAt).Subtract(context.StartedAt).TotalSeconds.ToString("F1"))s</MudTd>
            <MudTd>
                @if (context.Success)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    @if (!string.IsNullOrEmpty(context.Output))
                    {
                        <MudTooltip Text="@context.Output"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="color: var(--sw-text-muted);" /></MudTooltip>
                    }
                }
                else
                {
                    <MudTooltip Text="@context.Error">
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Small" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Create Dialog *@
<MudDialog Visible="_showDialog" VisibleChanged="@(v => _showDialog = v)" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>@L["ScheduledTasksView_Dialog_CreateTitle"]</TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="_formName" Immediate="true" Label="@L["ScheduledTasksView_Field_Name"]" Variant="Variant.Outlined" Class="mb-3" />
            <MudSelect T="string" Value="_formServerId" ValueChanged="OnTaskServerChanged" Label="@L["ScheduledTasksView_Field_TargetServer"]" Variant="Variant.Outlined" Class="mb-3">
                @foreach (var srv in _servers)
                {
                    <MudSelectItem Value="@srv.Id">@srv.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Whiskers.Models.ScheduledTaskType" Value="_formType" ValueChanged="OnTaskTypeChanged" Label="@L["ScheduledTasksView_Field_Type"]" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem Value="Whiskers.Models.ScheduledTaskType.ContainerRestart">@L["ScheduledTasksView_TaskType_ContainerRestart"]</MudSelectItem>
                <MudSelectItem Value="Whiskers.Models.ScheduledTaskType.DbBackup">@L["ScheduledTasksView_TaskType_DbBackup"]</MudSelectItem>
                <MudSelectItem Value="Whiskers.Models.ScheduledTaskType.VolumeBackup">@L["ScheduledTasksView_TaskType_VolumeBackup"]</MudSelectItem>
                <MudSelectItem Value="Whiskers.Models.ScheduledTaskType.SelfBackup">@L["ScheduledTasksView_TaskType_SelfBackup"]</MudSelectItem>
                <MudSelectItem Value="Whiskers.Models.ScheduledTaskType.CustomCommand">@L["ScheduledTasksView_TaskType_CustomCommand"]</MudSelectItem>
                <MudSelectItem Value="Whiskers.Models.ScheduledTaskType.Cleanup">@L["ScheduledTasksView_TaskType_Cleanup"]</MudSelectItem>
            </MudSelect>

            @if (_formType is ScheduledTaskType.ContainerRestart or ScheduledTaskType.DbBackup)
            {
                <MudSelect T="string" @bind-Value="_formTargetId" Label="@L["ScheduledTasksView_Field_Container"]" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var c in _containers.Where(c => _formType == ScheduledTaskType.DbBackup ? c.IsDatabase : true))
                    {
                        <MudSelectItem Value="@c.Name">@c.Name (@c.Image)</MudSelectItem>
                    }
                </MudSelect>
            }
            else if (_formType == ScheduledTaskType.VolumeBackup)
            {
                <MudTextField @bind-Value="_formTargetId" Immediate="true" Label="@L["ScheduledTasksView_Field_VolumeName"]" Variant="Variant.Outlined" Class="mb-3" />
            }
            else if (_formType == ScheduledTaskType.CustomCommand)
            {
                <MudTextField @bind-Value="_formCommand" Immediate="true" Label="@L["ScheduledTasksView_Field_Command"]" Variant="Variant.Outlined" Class="mb-3"
                              Style="font-family: 'JetBrains Mono', monospace;" Placeholder="docker system prune -f" />
            }

            <MudTextField @bind-Value="_formCron" Immediate="true" Label="@L["ScheduledTasksView_Field_CronSchedule"]" Variant="Variant.Outlined" Class="mb-3"
                          Style="font-family: 'JetBrains Mono', monospace;"
                          HelperText="@L["ScheduledTasksView_Field_CronHelperText"]"
                          Error="@(!string.IsNullOrWhiteSpace(_formCron) && !IsCronValid)" ErrorText="@L["ScheduledTasksView_Field_CronInvalid"]" />

            <MudStack Row="true" Spacing="1" Class="mb-3">
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _formCron = "0 2 * * *")">@L["ScheduledTasksView_CronPreset_Daily"]</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _formCron = "0 */6 * * *")">@L["ScheduledTasksView_CronPreset_Every6h"]</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _formCron = "0 3 * * 0")">@L["ScheduledTasksView_CronPreset_Sunday"]</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _formCron = "0 0 1 * *")">@L["ScheduledTasksView_CronPreset_Monthly"]</MudButton>
            </MudStack>

            @if (_formType is ScheduledTaskType.DbBackup or ScheduledTaskType.VolumeBackup or ScheduledTaskType.SelfBackup)
            {
                <MudNumericField T="int" @bind-Value="_formMaxBackups" Label="@L["ScheduledTasksView_Field_MaxBackups"]"
                                 Variant="Variant.Outlined" Min="0" Max="100" />
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showDialog = false)">@L["ScheduledTasksView_Button_Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateTask"
                       Disabled="@(!CanCreate)">@L["ScheduledTasksView_Button_Create"]</MudButton>
        </DialogActions>
    </MudDialog>

@code {
    private List<Whiskers.Models.ScheduledTaskEntity> _tasks = new();
    private List<Whiskers.Models.TaskRunHistoryEntity> _history = new();
    private List<Whiskers.Models.ContainerInfo> _containers = new();
    private bool _showDialog;

    // Form
    private string _formName = "";
    private ScheduledTaskType _formType = ScheduledTaskType.ContainerRestart;
    private string _formTargetId = "";
    private string _formCron = "0 2 * * *";
    private string _formCommand = "";
    private int _formMaxBackups = 7;
    private List<Whiskers.Models.ServerConfig> _servers = new();
    private string _formServerId = "local";
    private AppRole _role = AppRole.Viewer;
    private string? _email;

    private bool IsMine(string? ownerId) =>
        !string.IsNullOrWhiteSpace(_email) && string.Equals(ownerId, PrincipalIds.User(_email), StringComparison.Ordinal);

    /// <summary>The task has an owner, but that owner may no longer change anything (removed or demoted user, a
    /// deleted or disabled key): its runs are refused until an admin takes it over.</summary>
    private bool OwnerRevoked(Whiskers.Models.ScheduledTaskEntity task) =>
        !string.IsNullOrWhiteSpace(task.CreatedBy)
        && OwnerResolver.Resolve(task.CreatedBy).PermissionLevel == McpPermissionLevels.Read;

    // "Run now" of a custom command runs arbitrary shell text on a host, so it needs Admin (ADR-0005, PC-D2);
    // every other task type keeps Operator.
    // A custom command runs as root; a self-backup and any retention delete recovery points: Admin.
    private static AppRole RunNowRole(Whiskers.Models.ScheduledTaskEntity task) =>
        task.TaskType is ScheduledTaskType.CustomCommand or ScheduledTaskType.SelfBackup || RetentionDecision(task) is not null
            ? AppRole.Admin
            : AppRole.Operator;

    private AppRole RoleOf(string capabilityId) =>
        Whiskers.Services.Mutations.CapabilityCatalog.RoleFor(
            Capabilities.Find(capabilityId)?.RequiredLevel ?? McpPermissionLevels.Admin);

    private bool Require(AppRole required)
    {
        if (_role < required)
        {
            Snackbar.Add(L["ScheduledTasksView_Snackbar_NoPermission", required, _role].Value, Severity.Warning);
            return false;
        }
        return true;
    }

    protected override async Task OnInitializedAsync()
    {
        _role = await CurrentUser.GetRoleAsync();
        _email = await CurrentUser.GetEmailAsync();
        _servers = ServerConfigService.GetEnabledServers();
        await LoadData();
    }

    private async Task LoadData()
    {
        _tasks = await Scheduler.GetTasksAsync();
        _history = await Scheduler.GetHistoryAsync(limit: 20);
    }

    private async Task ShowCreateDialog()
    {
        _formName = ""; _formTargetId = ""; _formCron = "0 2 * * *"; _formCommand = ""; _formMaxBackups = 7;
        _formServerId = ServerConfigService.GetDefaultServer()?.Id ?? "local";
        await LoadContainersForServer();
        _showDialog = true;
    }

    // Cron is parsed exactly like the scheduler does (5-field, no seconds), so the form
    // cannot persist an expression the scheduler would later reject.
    private bool IsCronValid => Whiskers.Services.Scheduler.SchedulerService.TryParseCron(_formCron.Trim(), out _);

    // Each task type needs its own target: a container, a volume name or a command.
    private bool HasRequiredTarget => _formType switch
    {
        ScheduledTaskType.ContainerRestart or ScheduledTaskType.DbBackup or ScheduledTaskType.VolumeBackup
            => !string.IsNullOrWhiteSpace(_formTargetId),
        ScheduledTaskType.CustomCommand => !string.IsNullOrWhiteSpace(_formCommand),
        _ => true
    };

    private bool CanCreate => !string.IsNullOrWhiteSpace(_formName) && IsCronValid && HasRequiredTarget;

    private void OnTaskTypeChanged(ScheduledTaskType type)
    {
        // A target picked for the previous type (e.g. a container name) is meaningless for the new one.
        if (type != _formType) { _formTargetId = ""; _formCommand = ""; }
        _formType = type;
    }

    private async Task OnTaskServerChanged(string serverId)
    {
        _formServerId = serverId;
        _formTargetId = "";
        await LoadContainersForServer();
    }

    private async Task LoadContainersForServer()
    {
        var sid = _formServerId == "local" ? null : _formServerId;
        _containers = (await DockerService.ListContainersAsync(all: true, serverId: sid)).ToList();
    }

    private async Task CreateTask()
    {
        if (!Require(AppRole.Admin)) return;
        if (!CanCreate) return;
        // The creator owns the task: every run re-checks their authority (PC-D6). Without an email the task would
        // fall into the grace period meant for tasks from before owners were recorded.
        var owner = await CurrentUser.GetEmailAsync();
        if (string.IsNullOrWhiteSpace(owner))
        {
            Snackbar.Add(L["ScheduledTasksView_Snackbar_NoOwner"].Value, Severity.Warning);
            return;
        }
        try
        {
            var config = new Dictionary<string, string>();
            if (_formMaxBackups > 0) config["maxBackups"] = _formMaxBackups.ToString();
            if (!string.IsNullOrEmpty(_formCommand)) config["command"] = _formCommand;

            var newTask = new Whiskers.Models.ScheduledTaskEntity
            {
                Name = _formName,
                CronExpression = _formCron.Trim(),
                TaskType = _formType,
                TargetId = _formTargetId,
                TargetName = _formTargetId,
                ServerId = _formServerId,
                Config = config.Any() ? System.Text.Json.JsonSerializer.Serialize(config) : null,
                CreatedBy = PrincipalIds.User(owner),
                CreatedVia = PrincipalIds.User(owner),
            };
            // The command goes to the policy; the audit row keeps only its length (it may carry credentials).
            await Mutations.RunAsync("scheduler.create",
                new
                {
                    name = newTask.Name, taskType = newTask.TaskType.ToString(), serverId = newTask.ServerId,
                    command = config.GetValueOrDefault("command"),
                },
                _ => Scheduler.CreateTaskAsync(newTask));
            await AuditLog.LogAsync(await CurrentUser.GetEmailAsync() ?? "unknown", "web",
                "task.create", "scheduled-task", _formName, _formName, serverId: _formServerId);
            Snackbar.Add(L["ScheduledTasksView_Snackbar_TaskCreated", _formName].Value, Severity.Success);
            _showDialog = false;
            await LoadData();
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ScheduledTasksView_Snackbar_Error", ex.Message].Value, Severity.Error);
        }
    }

    /// <summary>"Run now" is decided twice: once for the task's own action and target as the person clicking (a
    /// protected container, a switched-off or stricter capability, the kill switch), then as <c>scheduler.run</c>.
    /// Checking only <c>scheduler.run</c> would let anyone who may run tasks trigger what the task does.</summary>
    private Task<(bool Success, string Output)> RunNowGatedAsync(Whiskers.Models.ScheduledTaskEntity task)
    {
        var serverId = task.ServerId;
        var target = task.TargetId;
        return task.TaskType switch
        {
            ScheduledTaskType.ContainerRestart => Mutations.RunAsync("container.restart",
                new { containerId = target, name = task.TargetName, serverId }, _ => RunScheduledAsync(task)),
            ScheduledTaskType.DbBackup => Mutations.RunAsync("db.backup",
                new { containerId = target, name = task.TargetName, serverId }, _ => RunWithRetentionAsync(task)),
            ScheduledTaskType.VolumeBackup => Mutations.RunAsync("volume.backup",
                new { volumeName = target, serverId }, _ => RunWithRetentionAsync(task)),
            ScheduledTaskType.SelfBackup => Mutations.RunAsync("selfbackup.create",
                new { trigger = "run-now", taskId = task.TaskId }, _ => RunWithRetentionAsync(task)),
            ScheduledTaskType.CustomCommand => Mutations.RunAsync("host.exec",
                new { serverId, command = Whiskers.Services.Scheduler.TaskExecutor.CommandOf(task) },
                _ => RunScheduledAsync(task)),
            ScheduledTaskType.Cleanup => Mutations.RunAsync("host.prune",
                new { serverId }, _ => RunScheduledAsync(task)),
            _ => RunScheduledAsync(task),
        };
    }

    /// <summary>A backup task with retention also deletes old backups: that is decided as its own delete capability,
    /// so creating a backup (Operator) does not carry the right to remove recovery points (Admin).</summary>
    private Task<(bool Success, string Output)> RunWithRetentionAsync(Whiskers.Models.ScheduledTaskEntity task) =>
        RetentionDecision(task) is { } d
            ? Mutations.RunAsync(d.Capability, d.Arguments, _ => RunScheduledAsync(task))
            : RunScheduledAsync(task);

    private static (string Capability, object Arguments)? RetentionDecision(Whiskers.Models.ScheduledTaskEntity task)
    {
        if (Whiskers.Services.Scheduler.TaskExecutor.RetentionOf(task) == 0) return null;
        return task.TaskType switch
        {
            ScheduledTaskType.VolumeBackup => ("volume.backup_delete",
                new { volumeName = task.TargetId, serverId = task.ServerId, retention = true }),
            ScheduledTaskType.DbBackup => ("db.backup_delete",
                new { containerId = task.TargetId, name = task.TargetName, serverId = task.ServerId, retention = true }),
            ScheduledTaskType.SelfBackup => ("selfbackup.delete", new { retention = true }),
            _ => null,
        };
    }

    private Task<(bool Success, string Output)> RunScheduledAsync(Whiskers.Models.ScheduledTaskEntity task) =>
        Mutations.RunAsync("scheduler.run",
            new { taskId = task.TaskId, name = task.Name, taskType = task.TaskType.ToString(), serverId = task.ServerId },
            _ => Scheduler.RunNowAsync(task.TaskId));

    private async Task RunNow(Whiskers.Models.ScheduledTaskEntity task)
    {
        if (!Require(RunNowRole(task))) return;
        Snackbar.Add(L["ScheduledTasksView_Snackbar_TaskRunning", task.Name].Value, Severity.Info);
        bool success;
        string output;
        try
        {
            (success, output) = await RunNowGatedAsync(task);
        }
        catch (MutationRefusedException ex)
        {
            // Refused by the gateway: nothing ran, so no run-now audit row of our own.
            Snackbar.Add(ex.Message, Severity.Warning);
            return;
        }
        catch (Exception ex)
        {
            (success, output) = (false, ex.Message);
        }
        await AuditLog.LogAsync(await CurrentUser.GetEmailAsync() ?? "unknown", "web",
            "task.run-now", "scheduled-task", task.TaskId, task.Name, serverId: task.ServerId, success: success);
        Snackbar.Add(success ? L["ScheduledTasksView_Snackbar_RunSuccess", output].Value : L["ScheduledTasksView_Snackbar_Error", output].Value,
            success ? Severity.Success : Severity.Error);
        await LoadData();
    }

    private async Task ToggleEnabled(Whiskers.Models.ScheduledTaskEntity task, bool enabled)
    {
        if (!Require(AppRole.Admin)) return;
        task.Enabled = enabled;
        try
        {
            await Mutations.RunAsync("scheduler.update",
                new { taskId = task.TaskId, name = task.Name, taskType = task.TaskType.ToString(), serverId = task.ServerId, enabled },
                _ => Scheduler.UpdateTaskAsync(task));
            await AuditLog.LogAsync(await CurrentUser.GetEmailAsync() ?? "unknown", "web",
                enabled ? "task.enable" : "task.disable", "scheduled-task", task.TaskId, task.Name, serverId: task.ServerId);
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ScheduledTasksView_Snackbar_Error", ex.Message].Value, Severity.Error);
        }
        // Reload either way so the switch reflects the persisted state.
        await LoadData();
    }

    /// <summary>Takes over a task — one from before owners were recorded, one whose owner lost its authority, or any
    /// other; its runs then use this admin's authority. The previous owner goes into the audit row.</summary>
    private async Task AdoptTask(Whiskers.Models.ScheduledTaskEntity task)
    {
        if (!Require(AppRole.Admin)) return;
        if (await AdoptAsync(task))
            Snackbar.Add(L["ScheduledTasksView_Snackbar_Adopted", task.Name].Value, Severity.Success);
        await LoadData();
    }

    private async Task AdoptAll()
    {
        if (!Require(AppRole.Admin)) return;
        foreach (var task in _tasks.Where(t => string.IsNullOrWhiteSpace(t.CreatedBy) || OwnerRevoked(t)).ToList())
            if (!await AdoptAsync(task)) break;
        await LoadData();
    }

    private async Task<bool> AdoptAsync(Whiskers.Models.ScheduledTaskEntity task)
    {
        var email = await CurrentUser.GetEmailAsync();
        if (string.IsNullOrWhiteSpace(email)) return false;
        var taskId = task.TaskId;
        try
        {
            var owner = PrincipalIds.User(email);
            await Mutations.RunAsync("scheduler.update",
                new { taskId, name = task.Name, taskType = task.TaskType.ToString(), serverId = task.ServerId, owner },
                _ => Scheduler.SetOwnerAsync(taskId, owner));
            await AuditLog.LogAsync(email, "web", "task.adopt", "scheduled-task", taskId, task.Name,
                details: $"owner={owner}; previous={(string.IsNullOrWhiteSpace(task.CreatedBy) ? "-" : task.CreatedBy)}",
                serverId: task.ServerId);
            return true;
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ScheduledTasksView_Snackbar_Error", ex.Message].Value, Severity.Error);
        }
        return false;
    }

    private async Task DeleteTask(Whiskers.Models.ScheduledTaskEntity task)
    {
        // The level comes from the capability catalog, the one table the MCP tool uses too (R1-05).
        if (!Require(RoleOf("scheduler.delete"))) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["ScheduledTasksView_Dialog_DeleteTitle"].Value,
            L["ScheduledTasksView_Dialog_DeleteMessage", task.Name].Value,
            yesText: L["ScheduledTasksView_Dialog_DeleteConfirm"].Value, cancelText: L["ScheduledTasksView_Dialog_Cancel"].Value);
        if (confirmed != true) return;
        try
        {
            await Mutations.RunAsync("scheduler.delete",
                new { taskId = task.TaskId, name = task.Name, taskType = task.TaskType.ToString(), serverId = task.ServerId },
                _ => Scheduler.DeleteTaskAsync(task.TaskId));
            await AuditLog.LogAsync(await CurrentUser.GetEmailAsync() ?? "unknown", "web",
                "task.delete", "scheduled-task", task.TaskId, task.Name, serverId: task.ServerId);
            Snackbar.Add(L["ScheduledTasksView_Snackbar_TaskDeleted", task.Name].Value, Severity.Success);
            await LoadData();
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ScheduledTasksView_Snackbar_Error", ex.Message].Value, Severity.Error);
        }
    }

    private static Color GetTypeColor(ScheduledTaskType type) => type switch
    {
        ScheduledTaskType.ContainerRestart => Color.Primary,
        ScheduledTaskType.DbBackup => Color.Warning,
        ScheduledTaskType.VolumeBackup => Color.Info,
        ScheduledTaskType.SelfBackup => Color.Success,
        ScheduledTaskType.CustomCommand => Color.Tertiary,
        ScheduledTaskType.Cleanup => Color.Default,
        _ => Color.Default
    };

    private string GetTypeLabel(ScheduledTaskType type) => type switch
    {
        ScheduledTaskType.ContainerRestart => L["ScheduledTasksView_TypeLabel_Restart"].Value,
        ScheduledTaskType.DbBackup => L["ScheduledTasksView_TypeLabel_DbBackup"].Value,
        ScheduledTaskType.VolumeBackup => L["ScheduledTasksView_TypeLabel_VolumeBackup"].Value,
        ScheduledTaskType.SelfBackup => L["ScheduledTasksView_TypeLabel_SelfBackup"].Value,
        ScheduledTaskType.CustomCommand => L["ScheduledTasksView_TypeLabel_Command"].Value,
        ScheduledTaskType.Cleanup => L["ScheduledTasksView_TypeLabel_Cleanup"].Value,
        _ => type.ToString()
    };
}
