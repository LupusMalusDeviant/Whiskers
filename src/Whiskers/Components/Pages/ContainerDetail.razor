@page "/container/{ContainerId}"
@page "/container/{ServerId}/{ContainerId}"
@attribute [Authorize]
@inject IDockerService DockerService
@inject IHealthStore HealthStore
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Whiskers.Services.Auth.ICurrentUserService CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ITerminalSessionManager SessionManager
@inject IMetricsQueryService MetricsQuery
@inject IHostCommandExecutor HostCommandExecutor
@inject Whiskers.Services.ServerConfig.IServerConfigService ServerConfigService
@inject Whiskers.Services.Cve.ICveFindingsStore CveStore
@inject IUiMutationRunner Mutations
@inject IComposePlanner ComposePlanner
@inject IStringLocalizer<SharedResource> L
@using Whiskers.Models.Cve
@implements IAsyncDisposable

<PageTitle>@(_container?.Name ?? "Container") - Whiskers</PageTitle>

@if (_container == null)
{
    @if (_initialLoadDone)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-4" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
            <MudAlert Severity="Severity.Warning">
                Container <code>@(ContainerId.Length > 12 ? ContainerId[..12] : ContainerId)</code> @L["ContainerDetail_Alert_NotFound"]
            </MudAlert>
        </MudStack>
    }
    else
    {
        <MudProgressCircular Indeterminate="true" />
    }
}
else
{
    @* Header *@
    <div class="sw-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack" />
        <div class="sw-page-icon">
            <MudIcon Icon="@Icons.Material.Filled.ViewInAr" Size="Size.Large" />
        </div>
        <MudText Typo="Typo.h5">@_container.Name</MudText>
        <MudChip T="string" Size="Size.Small" Color="@GetStateColor(_container.State)" Variant="Variant.Filled">
            @_container.State
        </MudChip>
        <HealthBadge Status="@_container.HealthStatus" />
        <MudSpacer />
        @if (_container.State == "running")
        {
            @if (_role >= AppRole.Operator)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Stop" OnClick="Stop">@L["ContainerDetail_Button_Stop"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="Restart">@L["ContainerDetail_Button_Restart"]</MudButton>
            }
        }
        else
        {
            @if (_role >= AppRole.Operator)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="Start">@L["ContainerDetail_Button_Start"]</MudButton>
            }
            @if (_role >= AppRole.Admin)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete" OnClick="Remove">@L["ContainerDetail_Button_Remove"]</MudButton>
            }
        }
    </MudStack>
    </div>

    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
        @* Overview Tab *@
        <MudTabPanel Text="@L["ContainerDetail_Tab_Overview"]" Icon="@Icons.Material.Filled.Info">
            <MudSimpleTable Striped="true" Dense="true">
                <tbody>
                    <tr><td><strong>ID</strong></td><td style="font-family: monospace;">@_container.Id</td></tr>
                    <tr><td><strong>Name</strong></td><td>@_container.Name</td></tr>
                    <tr><td><strong>Image</strong></td><td>@_container.Image</td></tr>
                    <tr><td><strong>Status</strong></td><td>@_container.Status</td></tr>
                    <tr><td><strong>@L["ContainerDetail_Overview_Created"]</strong></td><td>@_container.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td></tr>
                    <tr>
                        <td><strong>Ports</strong></td>
                        <td>@(string.Join(", ", _container.Ports.Select(p => p.ToString())))</td>
                    </tr>
                    @if (_container.Labels.Any())
                    {
                        <tr>
                            <td><strong>@L["ContainerDetail_Overview_Labels"]</strong></td>
                            <td>
                                @foreach (var (k, v) in _container.Labels.Take(10))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@k=@v</MudChip>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudTabPanel>

        @* Stats Tab *@
        <MudTabPanel Text="@L["ContainerDetail_Tab_Stats"]" Icon="@Icons.Material.Filled.BarChart">
            @if (_stats != null)
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.subtitle1">@L["ContainerDetail_Stats_CpuUsage"]</MudText>
                            <MudText Typo="Typo.h3" Color="Color.Primary">@_stats.CpuPercent.ToString("F2")%</MudText>
                            <ResourceGauge Value="@_stats.CpuPercent" />
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.subtitle1">@L["ContainerDetail_Stats_MemoryUsage"]</MudText>
                            <MudText Typo="Typo.h3" Color="Color.Secondary">
                                @FormatBytes(_stats.MemoryUsageBytes)
                            </MudText>
                            <MudText Typo="Typo.body2">@L["ContainerDetail_Stats_MemoryOfLimit", FormatBytes(_stats.MemoryLimitBytes), _stats.MemoryPercent.ToString("F1")]</MudText>
                            <ResourceGauge Value="@_stats.MemoryPercent" />
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.subtitle1">@L["ContainerDetail_Stats_NetworkIo"]</MudText>
                            <MudText>RX: @FormatBytes(_stats.NetworkRxBytes)</MudText>
                            <MudText>TX: @FormatBytes(_stats.NetworkTxBytes)</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.subtitle1">@L["ContainerDetail_Stats_DiskIo"]</MudText>
                            <MudText>@L["ContainerDetail_Stats_Read", FormatBytes(_stats.BlockReadBytes)]</MudText>
                            <MudText>@L["ContainerDetail_Stats_Write", FormatBytes(_stats.BlockWriteBytes)]</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @* Historical Charts *@
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4 mb-2" Spacing="2">
                    <MudText Typo="Typo.subtitle1">@L["ContainerDetail_Stats_History"]</MudText>
                    <MudSelect T="string" Value="_chartPeriod" Variant="Variant.Outlined" Margin="Margin.Dense"
                               Style="max-width: 120px;" Label="@L["ContainerDetail_Stats_Period"]" ValueChanged="@((string v) => { _chartPeriod = v; _ = LoadChartData(); })">
                        <MudSelectItem Value="@("1h")">@L["ContainerDetail_Stats_Period1h"]</MudSelectItem>
                        <MudSelectItem Value="@("6h")">@L["ContainerDetail_Stats_Period6h"]</MudSelectItem>
                        <MudSelectItem Value="@("24h")">@L["ContainerDetail_Stats_Period24h"]</MudSelectItem>
                        <MudSelectItem Value="@("7d")">@L["ContainerDetail_Stats_Period7d"]</MudSelectItem>
                        <MudSelectItem Value="@("30d")">@L["ContainerDetail_Stats_Period30d"]</MudSelectItem>
                    </MudSelect>
                </MudStack>

                @if (_cpuHistory.Count > 0)
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["ContainerDetail_Stats_CpuHistory"]</MudText>
                                <ApexCharts.ApexChart TItem="MetricPoint" Height="250"
                                           Options="@_cpuChartOptions">
                                    <ApexCharts.ApexPointSeries TItem="MetricPoint"
                                                     Items="_cpuHistory"
                                                     SeriesType="ApexCharts.SeriesType.Area"
                                                     XValue="@(p => p.Timestamp)"
                                                     YValue="@(p => (decimal)p.Value)"
                                                     Name="CPU %" />
                                    @* R1-55: the true peak of each point, kept through the roll-up tiers — only where points merge samples. *@
                                    @if (_cpuHistory.Any(p => p.Samples > 1))
                                    {
                                    <ApexCharts.ApexPointSeries TItem="MetricPoint"
                                                     Items="_cpuHistory"
                                                     SeriesType="ApexCharts.SeriesType.Line"
                                                     XValue="@(p => p.Timestamp)"
                                                     YValue="@(p => (decimal)p.Max)"
                                                     Name="@L["Metrics_Series_Peak"]" />
                                    }
                                </ApexCharts.ApexChart>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["ContainerDetail_Stats_MemoryHistory"]</MudText>
                                <ApexCharts.ApexChart TItem="MetricPoint" Height="250"
                                           Options="@_memChartOptions">
                                    <ApexCharts.ApexPointSeries TItem="MetricPoint"
                                                     Items="_memHistory"
                                                     SeriesType="ApexCharts.SeriesType.Area"
                                                     XValue="@(p => p.Timestamp)"
                                                     YValue="@(p => (decimal)p.Value)"
                                                     Name="@L["ContainerDetail_Stats_MemorySeries"]" />
                                    @if (_memHistory.Any(p => p.Samples > 1))
                                    {
                                    <ApexCharts.ApexPointSeries TItem="MetricPoint"
                                                     Items="_memHistory"
                                                     SeriesType="ApexCharts.SeriesType.Line"
                                                     XValue="@(p => p.Timestamp)"
                                                     YValue="@(p => (decimal)p.Max)"
                                                     Name="@L["Metrics_Series_Peak"]" />
                                    }
                                </ApexCharts.ApexChart>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudText Color="Color.Secondary" Class="mt-2">@L["ContainerDetail_Stats_NoHistory"]</MudText>
                }
            }
            else
            {
                <MudText Color="Color.Secondary">@L["ContainerDetail_Stats_OnlyRunning"]</MudText>
            }
        </MudTabPanel>

        @* Logs Tab *@
        <MudTabPanel Text="@L["ContainerDetail_Tab_Logs"]" Icon="@Icons.Material.Filled.Article">
            <LogViewer ContainerId="@ContainerId" ServerId="@_resolvedServerId" Height="calc(100vh - 320px)" />
        </MudTabPanel>

        @* Health Tab *@
        <MudTabPanel Text="@L["ContainerDetail_Tab_Health"]" Icon="@Icons.Material.Filled.MonitorHeart">
            @{ var records = HealthStore.GetHistory(ContainerId); }
            <MudTable Items="@records" Dense="true" Hover="true" Striped="true">
                <HeaderContent>
                    <MudTh>@L["ContainerDetail_Health_ColTimestamp"]</MudTh>
                    <MudTh>@L["ContainerDetail_Health_ColStatus"]</MudTh>
                    <MudTh>@L["ContainerDetail_Health_ColHealth"]</MudTh>
                    <MudTh>@L["ContainerDetail_Health_ColExitCode"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-family: monospace;">@context.Timestamp.ToLocalTime().ToString("HH:mm:ss")</MudTd>
                    <MudTd>@context.State</MudTd>
                    <MudTd><HealthBadge Status="@context.HealthStatus" /></MudTd>
                    <MudTd>@(context.ExitCode?.ToString() ?? "-")</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4">@L["ContainerDetail_Health_NoData"]</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        @* Terminal Tab - inline *@
        <MudTabPanel Text="@L["ContainerDetail_Tab_Terminal"]" Icon="@Icons.Material.Filled.Terminal">
            @if (!ServerConfigService.SupportsTerminal(_resolvedServerId))
            {
                <MudAlert Severity="Severity.Info">
                    @L["ContainerDetail_Terminal_MtlsUnavailable"]
                    @L["ContainerDetail_Terminal_MtlsHintPrefix"] <code>execute_command</code> @L["ContainerDetail_Terminal_MtlsHintSuffix"]
                </MudAlert>
            }
            else if (_container.State != "running")
            {
                <MudAlert Severity="Severity.Warning">@L["ContainerDetail_Terminal_OnlyRunning"]</MudAlert>
            }
            else if (!string.IsNullOrEmpty(_termError))
            {
                <MudAlert Severity="Severity.Error">@_termError</MudAlert>
            }
            else
            {
                <div id="container-terminal" style="height: calc(100vh - 280px); min-height: 400px; width: 100%;"></div>
            }
        </MudTabPanel>

        @* Environment Variables Tab — Operator+ only, so a Viewer can't read env (MIT-37) *@
        @if (_role >= AppRole.Operator)
        {
        <MudTabPanel Text="@L["ContainerDetail_Tab_EnvVars"]" Icon="@Icons.Material.Filled.Code">
            @if (!_envLoaded)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
            }
            else
            {
                @* Read-only: Running container env vars (values always masked) *@
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["ContainerDetail_Env_RunningVars"]</MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @L["ContainerDetail_Env_MaskedInfo"]
                </MudAlert>
                <MudTextField Value="@_envSearch" ValueChanged="@((string v) => _envSearch = v)"
                              Label="@L["ContainerDetail_Env_Search"]" Variant="Variant.Outlined" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                              Class="mb-3" Style="max-width: 400px;" />
                <MudTable Items="@FilteredContainerEnv" Dense="true" Hover="true" Striped="true"
                          FixedHeader="true" Height="300px" Class="mb-6">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<KeyValuePair<string,string>, object>(x => x.Key)">@L["ContainerDetail_Env_ColVariable"]</MudTableSortLabel></MudTh>
                        <MudTh>@L["ContainerDetail_Env_ColValue"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["ContainerDetail_Env_ColVariable"]"><code>@context.Key</code></MudTd>
                        <MudTd DataLabel="@L["ContainerDetail_Env_ColValue"]">
                            @if (Whiskers.Utils.EnvMasking.ShouldMask(context.Key, context.Value))
                            {
                                <code style="color: #888;">••••••••</code>
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="vertical-align: middle; color: #888; margin-left: 4px;" />
                            }
                            else
                            {
                                <code style="word-break: break-all;">@context.Value</code>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                @* Editable: .env file (only for compose containers) *@
                @if (_composeWorkingDir != null)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["ContainerDetail_Env_DotEnvFile"]</MudText>
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                        @L["ContainerDetail_Env_DotEnvWarning"]
                        <br /><code>@_composeWorkingDir/.env</code>
                    </MudAlert>

                    @if (_dotEnvError != null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@_dotEnvError</MudAlert>
                    }

                    @for (var i = 0; i < _dotEnvEntries.Count; i++)
                    {
                        var idx = i;
                        var entry = _dotEnvEntries[idx];
                        <MudStack Row="true" Class="mb-2" AlignItems="AlignItems.Center">
                            <MudTextField @bind-Value="entry.Key" Label="Key" Variant="Variant.Outlined"
                                          Style="max-width: 280px; font-family: monospace;"
                                          ReadOnly="@(!entry.IsNew)" />
                            @if (entry.IsSensitive)
                            {
                                @* Sensitive key: always masked, edit to overwrite *@
                                @if (entry.IsNew || entry.IsEditing)
                                {
                                    <MudTextField @bind-Value="entry.Value" Label="@(entry.IsNew ? L["ContainerDetail_Env_FieldValue"].Value : L["ContainerDetail_Env_FieldNewValue"].Value)"
                                                  Variant="Variant.Outlined"
                                                  Style="font-family: monospace;"
                                                  InputType="@(entry.ShowValue ? InputType.Text : InputType.Password)"
                                                  Adornment="Adornment.End"
                                                  AdornmentIcon="@(entry.ShowValue ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                                  OnAdornmentClick="@(() => entry.ShowValue = !entry.ShowValue)"
                                                  Placeholder="@(entry.IsEditing ? L["ContainerDetail_Env_EnterNewValue"].Value : "")" />
                                    @if (entry.IsEditing && !entry.IsNew)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Undo" Color="Color.Warning" Size="Size.Small"
                                                       OnClick="@(() => { entry.IsEditing = false; entry.Value = ""; })"
                                                       title="@L["ContainerDetail_Env_DiscardChange"]" />
                                    }
                                }
                                else
                                {
                                    <MudTextField Value="@("••••••••")" Label="@L["ContainerDetail_Env_FieldValueStored"]" Variant="Variant.Outlined"
                                                  Style="font-family: monospace; color: #888;" ReadOnly="true" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="@(() => { entry.IsEditing = true; entry.Value = ""; })"
                                                   title="@L["ContainerDetail_Env_EditValue"]" />
                                }
                            }
                            else
                            {
                                @* Non-sensitive key: normal editable field, show value *@
                                @if (entry.IsNew)
                                {
                                    <MudTextField @bind-Value="entry.Value" Label="@L["ContainerDetail_Env_FieldValue"]" Variant="Variant.Outlined"
                                                  Style="font-family: monospace;" />
                                }
                                else
                                {
                                    <MudTextField Value="@entry.OriginalValue"
                                                  ValueChanged="@((string v) => { entry.Value = v; entry.IsEditing = true; entry.OriginalValue = v; })"
                                                  Label="@L["ContainerDetail_Env_FieldValue"]" Variant="Variant.Outlined"
                                                  Style="font-family: monospace;" />
                                }
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => _dotEnvEntries.RemoveAt(idx))" title="@L["ContainerDetail_Env_RemoveVariable"]" />
                        </MudStack>
                    }

                    <MudStack Row="true" Class="mt-3" Spacing="2">
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                                   OnClick="@(() => _dotEnvEntries.Add(new EnvEntry { IsNew = true, IsSensitive = false }))">@L["ContainerDetail_Env_AddVariable"]</MudButton>
                        <MudSpacer />
                        @* Writing .env and restarting is Admin-only in SaveEnvAndRestart; Operators may read here. *@
                        @if (_role >= AppRole.Admin)
                        {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_envSaving"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveEnvAndRestart">
                            @if (_envSaving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                            @L["ContainerDetail_Env_SaveAndRestart"]
                        </MudButton>
                        }
                    </MudStack>
                }
                else
                {
                    <MudDivider Class="my-4" />
                    <MudAlert Severity="Severity.Info" Dense="true">
                        @L["ContainerDetail_Env_NoCompose"]
                    </MudAlert>
                }
            }
        </MudTabPanel>
        }

        @* Database Tab - only for database containers, and Operator+ like the env tab: loading it reads the
           container env for the credentials and exposes the DB user and schema (MIT-37). *@
        @if (_container.IsDatabase && _role >= AppRole.Operator)
        {
            <MudTabPanel Text="@L["ContainerDetail_Tab_Database"]" Icon="@Icons.Material.Filled.Storage">
                <ContainerDatabasePanel @ref="_dbPanel" Container="@_container" ContainerId="@ContainerId"
                                        ServerId="@_resolvedServerId" Role="@_role" State="@_dbState" />
            </MudTabPanel>
        }

        <MudTabPanel Text="@L["ContainerDetail_Tab_Cves"]" Icon="@Icons.Material.Filled.Security">
            @{
                // Not the route values: a notification deep link (/container/{id}) carries no server, and the
                // route id may be the short form while the store is keyed by the full one.
                var cveResult = CveStore.Get(_resolvedServerId ?? "local", _container.Id);
            }
            @if (cveResult == null)
            {
                <MudAlert Severity="MudBlazor.Severity.Info">
                    @L["ContainerDetail_Cve_NoScan"]
                </MudAlert>
            }
            else if (!string.IsNullOrEmpty(cveResult.Error))
            {
                <MudAlert Severity="MudBlazor.Severity.Warning">@L["ContainerDetail_Cve_ScanError", cveResult.Error]</MudAlert>
            }
            else if (cveResult.Findings.Count == 0)
            {
                <MudAlert Severity="MudBlazor.Severity.Success">@L["ContainerDetail_Cve_NoFindings"]</MudAlert>
            }
            else
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
                    <MudText Typo="Typo.body2">@L["ContainerDetail_Cve_FindingsCount", cveResult.Findings.Count]</MudText>
                    <MudText Typo="Typo.body2" Style="color:#888;">
                        Scan: @cveResult.ScannedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")
                    </MudText>
                </MudStack>
                <MudTable Items="@cveResult.Findings.OrderByDescending(f => f.Severity).ThenBy(f => f.CveId)" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>Severity</MudTh>
                        <MudTh>CVE-ID</MudTh>
                        <MudTh>@L["ContainerDetail_Cve_ColPackage"]</MudTh>
                        <MudTh>@L["ContainerDetail_Cve_ColInstalledFix"]</MudTh>
                        <MudTh>@L["ContainerDetail_Cve_ColTitle"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(context.Severity == CveSeverity.Critical ? Color.Error : context.Severity == CveSeverity.High ? Color.Warning : context.Severity == CveSeverity.Medium ? Color.Info : Color.Default)">
                                @context.Severity
                            </MudChip>
                        </MudTd>
                        <MudTd Style="font-family:monospace;">
                            @if (!string.IsNullOrEmpty(context.Reference))
                            {
                                <MudLink Href="@context.Reference" Target="_blank">@context.CveId</MudLink>
                            }
                            else
                            {
                                @context.CveId
                            }
                        </MudTd>
                        <MudTd Style="font-family:monospace;">@context.Package</MudTd>
                        <MudTd Style="font-family:monospace; font-size:0.85em;">
                            @(context.InstalledVersion ?? "?") → @(string.IsNullOrEmpty(context.FixedVersion) ? "(no fix)" : context.FixedVersion)
                        </MudTd>
                        <MudTd>@(context.Title is { Length: > 80 } t ? t[..80] + "…" : context.Title)</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{ 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public string ContainerId { get; set; } = string.Empty;
    [Parameter] public string ServerId { get; set; } = "";

    private ContainerInfo? _container;
    private bool _initialLoadDone;
    private ContainerStats? _stats;
    private Timer? _refreshTimer;
    private int _refreshing; // reentrancy guard for the periodic refresh (MIT-34)
    private int _activeTab;

    // Tab positions shift with what is rendered: the env and database tabs exist for Operator+ only, the
    // database tab only for database containers. Fixed numbers sent a Viewer's database click to the env
    // loader (which then read the env the role may not see) and left the database tab spinning forever.
    private const int TerminalTabIndex = 4;
    private int EnvTabIndex => _role >= AppRole.Operator ? 5 : -1;
    private int DbTabIndex => _container?.IsDatabase == true && _role >= AppRole.Operator ? 6 : -1;

    // Chart state
    private string _chartPeriod = "1h";
    private List<MetricPoint> _cpuHistory = new();
    private List<MetricPoint> _memHistory = new();
    private ApexCharts.ApexChartOptions<MetricPoint> _cpuChartOptions = CreateChartOptions("#2196F3");
