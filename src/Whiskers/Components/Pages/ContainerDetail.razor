    // Sensitivity decision (key keywords + credential-in-URL values) lives in Whiskers.Utils.EnvMasking.
    private static string MaskOrShowValue(string value, bool sensitive) =>
        string.IsNullOrEmpty(value) ? "(leer)" : sensitive ? "••••••••" : value;

    private class EnvEntry
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
        public string OriginalValue { get; set; } = ""; // stored server-side, never shown for sensitive keys
        public bool IsNew { get; set; }
        public bool IsEditing { get; set; }
        public bool ShowValue { get; set; }
        public bool IsSensitive { get; set; }

        /// <summary>Returns the effective value to write: new value if edited, otherwise original.</summary>
        /// A sensitive value opened for editing starts empty (the stored secret is never sent to the browser), so
        /// an edit left empty means "keep" — writing it would silently wipe the secret.
        public string EffectiveValue => IsNew ? Value
            : IsEditing && (!IsSensitive || !string.IsNullOrEmpty(Value)) ? Value
            : OriginalValue;
    }

    private AppRole _role = AppRole.Viewer;

    private static string Quote(string s) => Whiskers.Utils.ShellUtils.Quote(s);

    private bool Require(AppRole required)
    {
        if (_role < required)
        {
            Snackbar.Add(L["ContainerDetail_Snackbar_NoPermission", required, _role].Value, Severity.Warning);
            return false;
        }
        return true;
    }

    /// <summary>The role check in front of a mutation: a refusal is also the gateway's Denied event for
    /// <paramref name="capabilityId"/> on <paramref name="arguments"/>, so the attempt is on record once (R1-21).</summary>
    private async Task<bool> RequireAsync(AppRole required, string capabilityId, object arguments)
    {
        if (Require(required)) return true;
        await Mutations.RefuseAsync(capabilityId, arguments, $"Requires the {required} role.");
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _role = await CurrentUser.GetRoleAsync();
        await LoadContainer();
        _initialLoadDone = true;
        _ = LoadChartData();
        _refreshTimer = new Timer(async _ =>
        {
            // Guard reentrancy (a slow load must not stack) and catch everything — InvokeAsync after
            // circuit teardown throws in this async-void callback.
            if (Interlocked.Exchange(ref _refreshing, 1) == 1) return;
            try
            {
                // Only refresh stats when NOT on terminal tab to avoid interference
                if (_activeTab != TerminalTabIndex)
                {
                    await LoadContainer();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { /* circuit torn down or transient load error */ }
            finally { _refreshing = 0; }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5)); // OPT-9: single-inspect + longer interval
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialize terminal when tab is switched to terminal
        if (_activeTab == TerminalTabIndex && !_termInitialized && _container?.State == "running")
        {
            _termInitialized = true;
            await InitTerminal();
        }

        // Load env vars when tab is switched to env (Operator+ only — the tab does not exist for a Viewer)
        if (_activeTab == EnvTabIndex && !_envLoaded)
        {
            await LoadEnvVars();
            await InvokeAsync(StateHasChanged);
        }

        // Load database info when tab is switched to database (only for DB containers)
        if (_activeTab == DbTabIndex && _container?.IsDatabase == true && _dbPanel is not null)
            await _dbPanel.EnsureLoadedAsync();
    }

    private async Task InitTerminal()
    {
        if (!ServerConfigService.SupportsTerminal(_resolvedServerId)) return;
        // PC-D2: a shell in the container is Admin; the refused attempt is the gateway's Denied event (R1-21).
        if (!await RequireAsync(AppRole.Admin, "terminal.container_open", new { containerId = ContainerId, serverId = _resolvedServerId }))
        {
            _termError = L["ContainerDetail_Terminal_NoPermission"].Value;
            return;
        }
        try
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _termCts = new CancellationTokenSource();

            await JS.InvokeVoidAsync("Whiskers.Terminal.create", "container-terminal", _dotNetRef);

            // R1-17: opened through the gateway (Admin, kill switch, protected resources, audited open).
            var sessionId = Whiskers.Services.Terminal.TerminalSession.NewId();
            var sid = _resolvedServerId;
            _termSession = await Mutations.RunAsync("terminal.container_open",
                new { containerId = ContainerId, serverId = sid },
                ct => SessionManager.OpenContainerShellAsync(
                    new Whiskers.Services.Terminal.TerminalOpenRequest(sessionId, sid, ContainerId), ct));

            var opened = _termSession;
            _ = Task.WhenAll(ReadTermStreamAsync(opened.Output, _termCts.Token), ReadTermStreamAsync(opened.Errors, _termCts.Token))
                .ContinueWith(async _ =>
                {
                    // The shell ended (or was ended): its close event is recorded once, whoever gets there first.
                    if (!opened.IsRunning)
                        await SessionManager.CloseAsync(opened.SessionId, Whiskers.Services.Terminal.TerminalCloseReason.Exited);
                }, TaskScheduler.Default).Unwrap();
        }
        catch (Exception ex)
        {
            _termError = L["ContainerDetail_Terminal_InitError", ex.Message].Value;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReadTermStreamAsync(System.IO.StreamReader reader, CancellationToken ct)
    {
        var buffer = new char[4096];
        try
        {
            while (!ct.IsCancellationRequested)
            {
                var bytesRead = await reader.ReadAsync(buffer, 0, buffer.Length);
                if (bytesRead == 0) break;
                // Streaming output is activity too — keep the session from being idle-closed mid-output.
                _termSession?.Touch();
                var text = new string(buffer, 0, bytesRead);
                await InvokeAsync(async () =>
                {
                    await JS.InvokeVoidAsync("Whiskers.Terminal.write", "container-terminal", text);
                });
            }
        }
        catch (OperationCanceledException) { }
        catch { }
    }

    [JSInvokable]
    public async Task OnTerminalInput(string data)
    {
        if (_termSession is { IsRunning: true })
        {
            await _termSession.WriteAsync(data);
        }
    }

    // When the route carries no server (e.g. opened from a notification deep-link), we discover
    // which server the container lives on during the first load and remember it here.
    private string? _discoveredServerId;
    private bool _crossServerSearched;
    private string? _resolvedServerId => !string.IsNullOrEmpty(ServerId) ? ServerId : _discoveredServerId;

    // Tolerant id match: containers may be referenced by full (64-char) or short (12-char) id.
    private static bool MatchesId(string a, string b) =>
        a == b || (a.Length >= 12 && b.Length >= 12 && (a.StartsWith(b) || b.StartsWith(a)));

    private void GoBack()
    {
        // Use JS history.back() to properly navigate back within the SPA
        _ = JS.InvokeVoidAsync("history.back");
    }

    private async Task LoadContainer()
    {
        try
        {
            if (string.IsNullOrEmpty(ServerId) && _discoveredServerId == null && !_crossServerSearched)
            {
                // No server in the route → search every server once to locate the container,
                // then pin _discoveredServerId so later refreshes hit only that server.
                _crossServerSearched = true;
                var all = await DockerService.ListAllContainersAsync();
                var match = all.FirstOrDefault(c => c.Id == ContainerId)
                            ?? all.FirstOrDefault(c => MatchesId(c.Id, ContainerId));
                if (match != null)
                {
                    _discoveredServerId = match.ServerId;
                    _container = match;
                    // Charts were first loaded before discovery (against "local"); reload now that the real
                    // server is known so a notification deep-link shows the correct server's history.
                    _ = LoadChartData();
                }
            }
            else
            {
                // Single-container inspect (id filter) instead of listing every container each poll (OPT-9).
                _container = await DockerService.GetContainerAsync(ContainerId, _resolvedServerId)
                             ?? (await DockerService.ListContainersAsync(serverId: _resolvedServerId))
                                 .FirstOrDefault(c => MatchesId(c.Id, ContainerId));
            }

            if (_container?.State == "running")
            {
                _stats = await DockerService.GetContainerStatsAsync(ContainerId, _resolvedServerId);
            }
            else
            {
                _stats = null;
            }
        }
        catch { }
    }

    private async Task Start()
    {
        var name = _container?.Name ?? ContainerId;
        var containerId = ContainerId;
        var sid = _resolvedServerId;
        // The gateway's event is the record of this attempt — refused, failed or done (R1-21).
        if (!await RequireAsync(AppRole.Operator, "container.start", new { containerId, name, serverId = sid })) return;
        try { await Mutations.RunAsync("container.start", new { containerId, name, serverId = sid }, _ => DockerService.StartContainerAsync(containerId, sid)); Snackbar.Add(L["ContainerDetail_Snackbar_Started"].Value, Severity.Success); }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        await LoadContainer();
    }

