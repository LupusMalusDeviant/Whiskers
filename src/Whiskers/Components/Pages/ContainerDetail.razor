    private async Task Remove()
    {
        if (!await RequireAsync(AppRole.Admin, "container.remove",
                new { containerId = ContainerId, name = _container?.Name ?? ContainerId, serverId = _resolvedServerId })) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["ContainerDetail_Dialog_RemoveTitle"].Value,
            L["ContainerDetail_Dialog_RemoveMessage", _container?.Name ?? ContainerId].Value,
            yesText: L["ContainerDetail_Button_Remove"].Value, cancelText: L["ContainerDetail_Button_Cancel"].Value);
        if (confirmed != true) return;
        var name = _container?.Name ?? ContainerId;
        var containerId = ContainerId;
        var sid = _resolvedServerId;
        try
        {
            await Mutations.RunAsync("container.remove", new { containerId, name, serverId = sid },
                _ => DockerService.RemoveContainerAsync(containerId, force: true, serverId: sid));
            Snackbar.Add(L["ContainerDetail_Snackbar_Removed"].Value, Severity.Success);
            Nav.NavigateTo("/");
        }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static MudBlazor.Color GetStateColor(string state) => state switch
    {
        "running" => MudBlazor.Color.Success,
        "exited" => MudBlazor.Color.Error,
        "paused" => MudBlazor.Color.Warning,
        _ => MudBlazor.Color.Default
    };

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1073741824 => $"{bytes / 1073741824.0:F1} GB",
        >= 1048576 => $"{bytes / 1048576.0:F1} MB",
        >= 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes} B"
    };

