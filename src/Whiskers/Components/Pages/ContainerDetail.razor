    private async Task LoadEnvVars()
    {
        try
        {
            // 1. Get running container env vars
            _containerEnv = await DockerService.GetContainerEnvAsync(ContainerId, _resolvedServerId);

            // 2. Detect compose working dir from labels
            _composeWorkingDir = null;
            if (_container?.Labels.TryGetValue("com.docker.compose.project.working_dir", out var workDir) == true)
            {
                _composeWorkingDir = workDir;
            }
            else if (_container?.ComposeProject is { } project && project != "Standalone")
            {
                // Fallback: check standard deployment path
                var sid = _resolvedServerId ?? "local";
                var checkResult = await HostCommandExecutor.ExecuteAsync(sid,
                    $"test -f /opt/deployments/{Quote(project)}/docker-compose.yml && echo /opt/deployments/{Quote(project)}",
                    TimeSpan.FromSeconds(5));
                if (checkResult.Success && !string.IsNullOrWhiteSpace(checkResult.Output))
                    _composeWorkingDir = checkResult.Output.Trim();
            }

            // 3. Load .env file if compose project found
            if (_composeWorkingDir != null)
            {
                var sid = _resolvedServerId ?? "local";
                var result = await HostCommandExecutor.ExecuteAsync(sid,
                    $"cat {Quote(_composeWorkingDir + "/.env")} 2>/dev/null",
                    TimeSpan.FromSeconds(5));

                _dotEnvEntries.Clear();
                _dotEnvError = null;

                if (result.Success && !string.IsNullOrWhiteSpace(result.Output))
                {
                    foreach (var line in result.Output.Split('\n'))
                    {
                        var trimmed = line.Trim();
                        if (string.IsNullOrEmpty(trimmed) || trimmed.StartsWith('#'))
                            continue;

                        var idx = trimmed.IndexOf('=');
                        if (idx > 0)
                        {
                            var key = trimmed[..idx];
                            var val = trimmed[(idx + 1)..];
                            _dotEnvEntries.Add(new EnvEntry
                            {
                                Key = key,
                                Value = "",
                                OriginalValue = val,
                                IsNew = false,
                                IsEditing = false,
                                IsSensitive = Whiskers.Utils.EnvMasking.ShouldMask(key, val)
                            });
                        }
                    }
                }
                else
                {
                    _dotEnvError = L["ContainerDetail_Env_NoDotEnvFound"].Value;
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ContainerDetail_Env_LoadError", ex.Message].Value, Severity.Error);
        }
        finally
        {
            _envLoaded = true;
        }
    }

    private async Task SaveEnvAndRestart()
    {
        if (!await RequireAsync(AppRole.Admin, "container.env_file_save",
                new { containerId = ContainerId, name = _container?.Name, serverId = _resolvedServerId })) return;
        if (_composeWorkingDir == null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["ContainerDetail_Dialog_SaveEnvTitle"].Value,
            L["ContainerDetail_Dialog_SaveEnvMessage"].Value,
            yesText: L["ContainerDetail_Dialog_SaveEnvYes"].Value, cancelText: L["ContainerDetail_Button_Cancel"].Value);
        if (confirmed != true) return;
        _envSaving = true;

        try
        {
            var sid = _resolvedServerId ?? "local";

            // Build .env content
            var sb = new System.Text.StringBuilder();
            foreach (var entry in _dotEnvEntries)
            {
                if (!string.IsNullOrWhiteSpace(entry.Key))
                    sb.AppendLine($"{entry.Key}={entry.EffectiveValue}");
            }

            if (_container is null) return;   // container not loaded: nothing to decide on, so nothing is written
            // The plan (R1-07): the new .env for this container's project and every existing container `compose up`
            // then recreates or collides with — each is decided (protected resources, kill switch) before anything is
            // written, and exactly the planned .env and files are used. The content stays inside the delegate.
            var envContent = sb.ToString();
            var plan = await ComposePlanner.PlanEnvChangeAsync(_container, sid, _ => envContent);
            var affected = new List<ContainerInfo> { _container };
            affected.AddRange(plan.Containers.Where(c => c.Id != _container.Id));
            // What the project mounts is decided too (R1-16), as for a deployment: compose up recreates it with them.
            var restartResult = await Mutations.RunMountsAsync(plan, () => ForEachServiceAsync(affected, sid, 0,
                async () =>
                {
                    // Planned again right before writing: a container that turned up meanwhile was not decided.
                    var current = await ComposePlanner.PlanEnvChangeAsync(_container, sid, _ => envContent);
                    current.EnsureDecided(MutationScope.Current);
                    var restart = await HostCommandExecutor.ExecuteMutationAsync(sid, current.DeployScript(pull: false),
                        TimeSpan.FromMinutes(2));
                    if (!restart.Success) MutationScope.Fail("Writing .env or docker compose up failed.");
                    return restart;
                }));

            // Each affected container's gateway event records the save; a failed restart is Failed there (R1-21).
            if (restartResult.Success)
            {
                Snackbar.Add(L["ContainerDetail_Env_SaveSuccess"].Value, Severity.Success);
                // Reload env vars and container state
                _envLoaded = false;
                await LoadContainer();
                await LoadEnvVars();
            }
            else
            {
                Snackbar.Add(L["ContainerDetail_Env_RestartError", restartResult.Output, restartResult.Error].Value, Severity.Error);
            }
        }
        catch (MutationRefusedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["ContainerDetail_Snackbar_Error", ex.Message].Value, Severity.Error);
        }
        finally
        {
            _envSaving = false;
        }
    }

    /// <summary>Runs <paramref name="action"/> inside one <c>container.env_file_save</c> decision per affected
    /// container (nested), so a single refusal stops the whole save.</summary>
    private Task<T> ForEachServiceAsync<T>(IReadOnlyList<ContainerInfo> services, string serverId, int index,
        Func<Task<T>> action) =>
        index >= services.Count
            ? action()
            : Mutations.RunAsync("container.env_file_save",
                new { containerId = services[index].Id, name = services[index].Name, serverId },
                _ => ForEachServiceAsync(services, serverId, index + 1, action));


    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        _termCts?.Cancel();
        try
        {
            if (_termSession != null)
                await SessionManager.CloseAsync(_termSession.SessionId);
            await JS.InvokeVoidAsync("Whiskers.Terminal.dispose", "container-terminal");
        }
        catch { }
        _dotNetRef?.Dispose();
        _termCts?.Dispose();
    }
