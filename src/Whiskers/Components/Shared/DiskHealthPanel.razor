@using Whiskers.Services.Metrics.DiskHealth
@inject IDiskHealthSettingsService DiskHealthSettings
@inject Whiskers.Services.Auth.ICurrentUserService CurrentUser
@inject ISnackbar Snackbar
@inject IUiMutationRunner Mutations
@inject IStringLocalizer<SharedResource> L

@* R1-58 (contract 0005): whether disk health (SMART, md, ZFS) is read from the hosts' metrics endpoints. Off by default;
   a change is a gated, audited config.save (R1-11, R1-22). Admin only. *@

@if (_isAdmin)
{
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
    @L["DiskHealth_Intro"]
    <MudLink Href="@GuideUrl" Target="_blank" Typo="Typo.body2" id="disk-health-guide">@L["DiskHealth_GuideLink"]</MudLink>
</MudText>
<MudSwitch T="bool" Value="@_enabled" ValueChanged="@Toggle" Color="Color.Primary" Disabled="@(_saving || DiskHealthSettings.ReadOnly)"
           Label="@L["DiskHealth_Label_Enabled"]" id="disk-health-enabled" />
@if (DiskHealthSettings.ReadOnly)
{
    @* Review round 1: a value set by the environment or appsettings.json wins — shown read-only with its source. *@
    <MudText Typo="Typo.caption" Color="Color.Secondary" id="disk-health-readonly">@L["DiskHealth_ReadOnly", DiskHealthSettings.Source ?? ""]</MudText>
}
}

@code {
    /// <summary>The operations guide (smartmontools, the textfile script, the freshness limit, what each state means).
    /// On <c>main</c>: the app's version is the csproj's, which a development build shares with the last release tag —
    /// that tag would not hold the guide (review round 1, NIT: the version tag is not known reliably).</summary>
    public const string GuideUrl = "https://github.com/LupusMalusDeviant/Whiskers/blob/main/docs/operations/disk-health.md";

    private bool _isAdmin;
    private bool _enabled;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        // The Settings page is Admin-only; the panel checks again before it shows anything.
        _isAdmin = await CurrentUser.HasRoleAsync(Whiskers.Models.AppRole.Admin);
        _enabled = DiskHealthSettings.Enabled;
    }

    private async Task Toggle(bool value)
    {
        _enabled = value;
        await Save();
    }

    private async Task Save()
    {
        var wanted = _enabled;
        _saving = true;
        try
        {
            await Mutations.RunAsync("config.save", new { section = "diskhealth" },
                (ResolvedRecord rt, CancellationToken ct) => DiskHealthSettings.SaveAsync(wanted, ct));
            Snackbar.Add(L["DiskHealth_Snackbar_Saved"].Value, Severity.Success);
        }
        catch (MutationRefusedException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (ArgumentException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) when (ex is MutationFailedException or IOException or UnauthorizedAccessException or InvalidOperationException)
        {
            Snackbar.Add(L["DiskHealth_Snackbar_SaveFailed", ex.Message].Value, Severity.Error);
        }
        finally
        {
            // What is shown is what is in effect — a refused or failed save shows the setting unchanged.
            _enabled = DiskHealthSettings.Enabled;
            _saving = false;
        }
    }
}
