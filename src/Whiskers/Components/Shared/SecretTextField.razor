@inject IStringLocalizer<SharedResource> L

@* R1-30: an editor field for a credential kept in the vault. It never shows the stored value: empty keeps it, a new
   value replaces it, the delete icon removes it with the next save. *@
<MudTextField T="string" Value="@Value" ValueChanged="@ValueChanged" Label="@Label" InputType="InputType.Password"
              Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Clear"
              HelperText="@Helper"
              Adornment="@(Stored ? Adornment.End : Adornment.None)"
              AdornmentIcon="@(Clear ? Icons.Material.Filled.Undo : Icons.Material.Filled.DeleteOutline)"
              AdornmentAriaLabel="@(Clear ? L["SecretField_UndoClear"].Value : L["SecretField_Clear"].Value)"
              OnAdornmentClick="ToggleClear" />

@code {
    [Parameter] public string Label { get; set; } = "";

    /// <summary>A new value typed now; empty keeps the stored one.</summary>
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Whether a value is stored (or set by the environment) — never the value itself.</summary>
    [Parameter] public bool Stored { get; set; }

    /// <summary>Whether the next save removes the stored value.</summary>
    [Parameter] public bool Clear { get; set; }
    [Parameter] public EventCallback<bool> ClearChanged { get; set; }

    private string Helper => Clear ? L["SecretField_WillClear"].Value
        : Stored ? L["SecretField_Stored"].Value
        : L["SecretField_NotSet"].Value;

    private async Task ToggleClear()
    {
        Clear = !Clear;
        await ClearChanged.InvokeAsync(Clear);
        if (Clear && !string.IsNullOrEmpty(Value)) await ValueChanged.InvokeAsync("");
    }
}
