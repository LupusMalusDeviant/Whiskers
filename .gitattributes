# Force LF line endings for shell scripts, Dockerfile, and compose files.
# Prevents CRLF breakage when contributors commit from Windows.
*.sh           text eol=lf
Dockerfile     text eol=lf
*.Dockerfile   text eol=lf
docker-compose*.yml text eol=lf
.env.example   text eol=lf
.dockerignore  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
# Pinned keys (deploy/keys/): byte for byte as published, on every checkout.
*.asc          text eol=lf
# borg-fleet scripts and units have no .sh suffix but run on Linux hosts.
deploy/borg-fleet/** text eol=lf

# Default: let Git handle detection.
*              text=auto

# C# sources build verbatim/raw strings into host scripts and compose files; a CRLF checkout
# would put CR characters into them (Windows builds, tests). Keep them LF everywhere.
*.cs           text eol=lf
*.razor        text eol=lf
# Files Whiskers copies or edits on Linux hosts (scrape config, helm/k8s manifests).
deploy/**      text eol=lf
