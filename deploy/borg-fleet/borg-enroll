#!/bin/sh
# borg-enroll — enrol one Whiskers-managed server into the borg fleet backup (runs on Badwolf).
#
#     borg-enroll <whiskers-server-id> [--time HH:MM] [--first-run]
#
# Idempotent: re-running repairs a half-finished enrolment and changes nothing on a finished one.
#
# Steps:
#   1. install/refresh borg-fleet-client on the target (via the Whiskers MCP execute_command)
#   2. `prepare` on the target  -> borg installed, backup key + passphrase created, pubkey returned
#   3. Storage Box sub-account "whiskers-<id>" (Hetzner API) -> authorized_keys written via SFTP:
#        the server's key forced to `borg serve --append-only` (cannot delete), plus the
#        Badwolf admin key (unrestricted, used only by borg-fleet-prune)
#   4. `init` on the target    -> repo created (repokey-blake2, append_only=1), nightly timer
#   5. passphrase + repokey escrowed under /root/.config/borg-fleet/escrow/<id>/ (0600)
#
# Files (Badwolf, root only):
#   /root/.config/borg-fleet/fleet.json        box id/host, Whiskers MCP URL, timer slots
#   /root/.config/borg-fleet/hetzner-token     Hetzner API token (project of the Storage Box)
#   /root/.config/borg-fleet/whiskers-mcp-key  Whiskers MCP API key with execute_command
#   /root/.config/borg-fleet/admin_ed25519     admin (prune) key, generated on first use
#   /root/.config/borg-fleet/servers/<id>.json enrolment record (no secrets)
#
# Exit codes: 0 = enrolled; 1 = anything else (usage, missing tool, API/MCP/SFTP failure), message on stderr.
#
# Tools (POSIX sh, no Python — contract 0017 part I): every one is needed, the script refuses to start without it.
#   curl jq base64 sha256sum awk sed tr head tail cut grep cp cat rm mkdir chmod dirname date sleep mktemp
#   ssh-keygen sshpass sftp
# Secrets (API token, MCP key, sub-account passwords) never stand in a program's arguments: they travel in 0600
# files or on stdin.
set -eu
umask 077   # every file this script writes (headers, bodies, escrow, records) is private to root

TOOLS="curl jq base64 sha256sum awk sed tr head tail cut grep cp cat rm mkdir chmod dirname date sleep mktemp ssh-keygen sshpass sftp"
CFG_DIR=${BORG_FLEET_CFG_DIR:-/root/.config/borg-fleet}
API=https://api.hetzner.com/v1

die() {
    printf 'borg-enroll: %s\n' "$*" >&2
    exit 1
}

usage() {
    die "usage: borg-enroll <whiskers-server-id> [--time HH:MM] [--first-run]"
}

for tool in $TOOLS; do
    command -v "$tool" >/dev/null 2>&1 || die "missing tool: $tool"
done
CLIENT="$(cd "$(dirname "$0")" && pwd)/borg-fleet-client"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
trap 'exit 1' HUP INT TERM

read_file() {  # file -> stdout, trimmed like Python's str.strip() for single-line secrets
    [ -r "$1" ] || die "cannot read $1"
    tr -d '\r\n' < "$1"
}

# --- Hetzner Storage Box API ------------------------------------------------------------------
# The token reaches curl through a header file (0600 in $TMP), never through its arguments.

box_call() {  # method path [json-body] [allow-404]  -> response in $TMP/resp, status in BOX_STATUS
    _m=$1 _p=$2 _b=${3-} _a=${4-}
    rm -f "$TMP/resp"
    if [ -n "$_b" ]; then
        printf '%s' "$_b" > "$TMP/body"
        BOX_STATUS=$(curl -q -sS -X "$_m" -H @"$TMP/hz.hdr" -H 'Content-Type: application/json' --max-time 30 \
            --data-binary @"$TMP/body" -o "$TMP/resp" -w '%{http_code}' "$API$_p") || die "Hetzner API $_m $_p: no answer"
    else
        BOX_STATUS=$(curl -q -sS -X "$_m" -H @"$TMP/hz.hdr" --max-time 30 \
            -o "$TMP/resp" -w '%{http_code}' "$API$_p") || die "Hetzner API $_m $_p: no answer"
    fi
    [ -f "$TMP/resp" ] || : > "$TMP/resp"
    case $BOX_STATUS in
        2??) return 0 ;;
        404) [ -n "$_a" ] && return 0 ;;
    esac
    die "Hetzner API $_m $_p -> $BOX_STATUS: $(head -c 500 "$TMP/resp")"
}

wait_subaccount() {  # sub-id -> $TMP/sub (the sub-account object)
    # A fresh sub-account answers 404 until its create action has finished.
    _i=0
    while [ $_i -lt 60 ]; do
        box_call GET "/storage_boxes/$BOX_ID/subaccounts/$1" "" allow404
        if [ "$BOX_STATUS" != 404 ] && jq -e '.subaccount.username // empty | length > 0' "$TMP/resp" >/dev/null 2>&1; then
            jq -c '.subaccount' "$TMP/resp" > "$TMP/sub"
            return 0
        fi
        sleep 2
        _i=$((_i + 1))
    done
    die "sub-account $1 has no username after 120 s"
}

wait_action() {  # action JSON in $TMP/action
    _i=0
    while [ $_i -lt 60 ]; do
        [ "$(jq -r '.status' "$TMP/action")" = running ] || break
        sleep 2
        box_call GET "/storage_boxes/actions/$(jq -r '.id' "$TMP/action")"
        jq -c '.action' "$TMP/resp" > "$TMP/action"
        _i=$((_i + 1))
    done
    [ "$(jq -r '.status' "$TMP/action")" = success ] \
        || die "Hetzner action $(jq -r '.command' "$TMP/action") ended $(jq -r '.status' "$TMP/action"): $(jq -c '.error' "$TMP/action")"
}

reset_password() {  # sub-id password
    box_call POST "/storage_boxes/$BOX_ID/subaccounts/$1/actions/reset_subaccount_password" \
        "$(printf '%s' "$2" | jq -Rsc '{password: .}')"
    jq -c '.action' "$TMP/resp" > "$TMP/action"
    wait_action
}

new_password() {  # upper, lower, digit, special guaranteed
    printf 'Bf7#%s' "$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 28)"
}

# --- Whiskers MCP (streamable HTTP) ----------------------------------------------------------
# The key reaches curl through a header file as well. MCP_SESSION carries the session id.

MCP_SESSION="" MCP_N=0

mcp_post() {  # json-payload -> answer (one JSON message or empty) in $TMP/mcp.msg
    { printf 'Authorization: Bearer %s\n' "$MCP_KEY"
      printf 'Accept: application/json, text/event-stream\n'
      [ -z "$MCP_SESSION" ] || printf 'Mcp-Session-Id: %s\n' "$MCP_SESSION"
    } > "$TMP/mcp.hdr"
    printf '%s' "$1" > "$TMP/mcp.req"
    rm -f "$TMP/mcp.body" "$TMP/mcp.resphdr"
    curl -q -sS -f -H @"$TMP/mcp.hdr" -H 'Content-Type: application/json' --max-time 700 \
        --data-binary @"$TMP/mcp.req" -D "$TMP/mcp.resphdr" -o "$TMP/mcp.body" "$MCP_URL" >/dev/null \
        || die "MCP request to $MCP_URL failed"
    [ -f "$TMP/mcp.body" ] || : > "$TMP/mcp.body"
    _s=$(tr -d '\r' < "$TMP/mcp.resphdr" | awk 'tolower($0) ~ /^mcp-session-id:/ { sub(/^[^:]*:[ \t]*/, ""); v = $0 } END { print v }')
    [ -z "$_s" ] || MCP_SESSION=$_s
    if [ -z "$(tr -d ' \t\r\n' < "$TMP/mcp.body")" ]; then
        : > "$TMP/mcp.msg"
    elif [ "$(tr -d ' \t\r\n' < "$TMP/mcp.body" | head -c 1)" = "{" ]; then
        jq -c . "$TMP/mcp.body" > "$TMP/mcp.msg" || die "MCP answer is not JSON"
    else  # SSE: the first data: frame carrying a result or an error
        tr -d '\r' < "$TMP/mcp.body" | sed -n 's/^data://p' \
            | jq -c 'select(type == "object" and (has("result") or has("error")))' 2>/dev/null | head -n 1 > "$TMP/mcp.msg" || :
    fi
}

mcp_rpc() {  # method params-json -> result in $TMP/mcp.result
    MCP_N=$((MCP_N + 1))
    mcp_post "$(jq -cn --argjson id "$MCP_N" --arg m "$1" --argjson p "$2" '{jsonrpc: "2.0", id: $id, method: $m, params: $p}')"
    [ -s "$TMP/mcp.msg" ] || die "MCP $1: no answer"
    if jq -e 'has("error")' "$TMP/mcp.msg" >/dev/null; then
        die "MCP $1: $(jq -c '.error' "$TMP/mcp.msg")"
    fi
    jq -c '.result' "$TMP/mcp.msg" > "$TMP/mcp.result"
}

mcp_connect() {
    mcp_rpc initialize '{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"borg-enroll","version":"1"}}'
    mcp_post '{"jsonrpc":"2.0","method":"notifications/initialized"}'
}

mcp_run() {  # server-id command-file timeout -> text in $TMP/run.out, exit code in RUN_CODE
    mcp_rpc tools/call "$(jq -cn --arg s "$1" --rawfile c "$2" --argjson t "$3" \
        '{name: "execute_command", arguments: {serverId: $s, command: $c, timeoutSeconds: $t}}')"
    jq -j '[.content[]? | .text // ""] | join("\n")' "$TMP/mcp.result" > "$TMP/run.out"
    RUN_CODE=0
    if [ "$(head -c 10 "$TMP/run.out")" = "Exit code:" ]; then
        RUN_CODE=$(head -n 1 "$TMP/run.out" | cut -d: -f2 | tr -d ' \t\r')
        case $RUN_CODE in ''|*[!0-9-]*) die "unreadable exit code in: $(head -n 1 "$TMP/run.out")" ;; esac
    fi
}

kv() {  # KEY file -> value of the last KEY=... line; fails when there is none
    awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2); f = 1 } END { if (!f) exit 1; print v }' "$2"
}

# --- main -------------------------------------------------------------------------------------

slot() {  # server-id -> HH:MM: fleet.json "times", else a fixed 15-minute slot between 00:30 and 05:15
    if jq -e --arg id "$1" '(.times // {}) | has($id)' "$CFG_DIR/fleet.json" >/dev/null; then
        jq -r --arg id "$1" '.times[$id]' "$CFG_DIR/fleet.json"
        return
    fi
    printf '%s' "$1" | sha256sum | cut -c1-64 | awk '{
        v = 0
        for (i = 1; i <= length($0); i++) v = (v * 16 + index("0123456789abcdef", substr($0, i, 1)) - 1) % 20
        m = 30 + v * 15
        printf "%02d:%02d\n", int(m / 60), m % 60 }'
}

sftp_write_authorized_keys() {  # user host password content-file
    (umask 077; mkdir "$TMP/sftp")
    cp "$4" "$TMP/sftp/authorized_keys"
    # No "-b": sftp's batch mode forces BatchMode=yes and thereby disables password auth.
    # Commands come from stdin instead; "-mkdir" tolerates an existing .ssh.
    printf -- '-mkdir .ssh\nput %s .ssh/authorized_keys\nchmod 600 .ssh/authorized_keys\nls -l .ssh\n' "$TMP/sftp/authorized_keys" \
        | SSHPASS=$3 sshpass -e sftp -P 23 -o BatchMode=no -o StrictHostKeyChecking=accept-new \
            -o "UserKnownHostsFile=$CFG_DIR/known_hosts" -o PubkeyAuthentication=no \
            -o PreferredAuthentications=password "$1@$2" > "$TMP/sftp.out" 2> "$TMP/sftp.err" \
        && grep -q authorized_keys "$TMP/sftp.out" \
        || die "sftp authorized_keys upload failed: $(cat "$TMP/sftp.err") $(tail -c 300 "$TMP/sftp.out")"
    rm -rf "$TMP/sftp"
}

[ $# -ge 1 ] || usage
case $1 in -*) usage ;; esac
SERVER_ID=$1
shift
case $SERVER_ID in ''|*/*|.*) die "invalid server id: '$SERVER_ID'" ;; esac
FIRST_RUN=0 TIME_SLOT=""
while [ $# -gt 0 ]; do
    case $1 in
        --first-run) FIRST_RUN=1 ;;
        --time) [ $# -ge 2 ] || usage; TIME_SLOT=$2; shift ;;
    esac
    shift
done

[ -r "$CFG_DIR/fleet.json" ] || die "cannot read $CFG_DIR/fleet.json"
jq -e . "$CFG_DIR/fleet.json" >/dev/null 2>&1 || die "$CFG_DIR/fleet.json is not JSON"
[ -n "$TIME_SLOT" ] || TIME_SLOT=$(slot "$SERVER_ID")
case $TIME_SLOT in
    [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
    *) die "invalid time slot: $TIME_SLOT (HH:MM)" ;;
esac

BOX_ID=$(jq -r '.box_id // empty' "$CFG_DIR/fleet.json")
case $BOX_ID in ''|*[!0-9]*) die "fleet.json: box_id missing or not a number" ;; esac
MCP_URL=$(jq -r '.whiskers_mcp_url // empty' "$CFG_DIR/fleet.json")
[ -n "$MCP_URL" ] || die "fleet.json: whiskers_mcp_url missing"
TOKEN_FILE=$(jq -r --arg d "$CFG_DIR/hetzner-token" '.hetzner_token_file // $d' "$CFG_DIR/fleet.json")
TOKEN=$(read_file "$TOKEN_FILE")
MCP_KEY=$(read_file "$CFG_DIR/whiskers-mcp-key")
(umask 077; printf 'Authorization: Bearer %s\n' "$TOKEN" > "$TMP/hz.hdr")
unset TOKEN

box_call GET "/storage_boxes/$BOX_ID"
HOST=$(jq -r '.storage_box.server // empty' "$TMP/resp")
[ -n "$HOST" ] || die "Hetzner API: storage box $BOX_ID has no server name"
if ! jq -e '.storage_box.snapshot_plan' "$TMP/resp" >/dev/null 2>&1; then
    # Box-side daily snapshots: out of reach of every SSH key, incl. Badwolf's admin key.
    box_call POST "/storage_boxes/$BOX_ID/actions/enable_snapshot_plan" \
        '{"max_snapshots":14,"hour":6,"minute":30,"day_of_week":null,"day_of_month":null}'
    echo "box: snapshot plan enabled (daily 06:30 UTC, keep 14)"
fi
mcp_connect

ADMIN_KEY="$CFG_DIR/admin_ed25519"
[ -e "$ADMIN_KEY" ] || ssh-keygen -q -t ed25519 -N '' -C borg-fleet-admin@badwolf -f "$ADMIN_KEY" \
    || die "ssh-keygen failed"

# 1+2: client script + prepare
[ -r "$CLIENT" ] || die "cannot read $CLIENT"
B64=$(base64 -w0 "$CLIENT")
# tee + mv, not "install /dev/stdin": uutils install (Ubuntu 26.04) fails on long pipes
printf '%s' "echo $B64 | base64 -d | sudo tee /usr/local/sbin/borg-fleet-client.new >/dev/null && sudo chmod 755 /usr/local/sbin/borg-fleet-client.new && sudo mv /usr/local/sbin/borg-fleet-client.new /usr/local/sbin/borg-fleet-client && sudo /usr/local/sbin/borg-fleet-client prepare" \
    > "$TMP/cmd"
mcp_run "$SERVER_ID" "$TMP/cmd" 600
[ "$RUN_CODE" = 0 ] || die "prepare failed on $SERVER_ID:
$(cat "$TMP/run.out")"
cp "$TMP/run.out" "$TMP/prep"
VERSION=$(kv BORG_VERSION "$TMP/prep") || die "prepare on $SERVER_ID printed no BORG_VERSION"
PUBKEY=$(kv PUBKEY "$TMP/prep") || die "prepare on $SERVER_ID printed no PUBKEY"
case $VERSION in 1.4*) REMOTE_PATH=borg-1.4 ;; *) REMOTE_PATH=borg-1.2 ;; esac
echo "[$SERVER_ID] borg $VERSION -> remote $REMOTE_PATH"

# 3: sub-account + keys
box_call GET "/storage_boxes/$BOX_ID/subaccounts"
jq -c --arg id "$SERVER_ID" \
    'first(.subaccounts[]? | select(((.labels // {})["whiskers-server"]) == $id)) // empty' "$TMP/resp" > "$TMP/sub"
PASSWORD=$(new_password)
if [ ! -s "$TMP/sub" ]; then
    box_call POST "/storage_boxes/$BOX_ID/subaccounts" "$(printf '%s' "$PASSWORD" | jq -Rsc --arg id "$SERVER_ID" '{
        name: ("whiskers-" + $id)[0:64],
        home_directory: ("whiskers-" + $id),
        password: .,
        description: ("borg-fleet backup of Whiskers server " + $id),
        labels: {"whiskers-server": $id, "managed-by": "borg-fleet"},
        access_settings: {reachable_externally: true, ssh_enabled: true, samba_enabled: false,
                          webdav_enabled: false, readonly: false}}')"
    wait_subaccount "$(jq -r '.subaccount.id' "$TMP/resp")"
    echo "[$SERVER_ID] created sub-account $(jq -r '.username' "$TMP/sub")"
else
    reset_password "$(jq -r '.id' "$TMP/sub")" "$PASSWORD"
    echo "[$SERVER_ID] reusing sub-account $(jq -r '.username' "$TMP/sub")"
fi
SUB_USER=$(jq -r '.username' "$TMP/sub")
SUB_ID=$(jq -c '.id' "$TMP/sub")
[ -r "$ADMIN_KEY.pub" ] || die "cannot read $ADMIN_KEY.pub"
{ printf 'command="%s serve --append-only --restrict-to-repository borg",restrict %s\n' "$REMOTE_PATH" "$PUBKEY"
  printf '%s\n' "$(read_file "$ADMIN_KEY.pub")"
} > "$TMP/authorized_keys"
sftp_write_authorized_keys "$SUB_USER" "$HOST" "$PASSWORD" "$TMP/authorized_keys"
# Lock password login again by rotating to a value nobody keeps.
reset_password "$SUB_ID" "$(new_password)"
unset PASSWORD

# 4: init + timer
REPO="ssh://$SUB_USER@$HOST:23/./borg"
printf '%s' "sudo /usr/local/sbin/borg-fleet-client init '$REPO' $TIME_SLOT $REMOTE_PATH" > "$TMP/cmd"
mcp_run "$SERVER_ID" "$TMP/cmd" 600
[ "$RUN_CODE" = 0 ] || die "init failed on $SERVER_ID:
$(cat "$TMP/run.out")"
cp "$TMP/run.out" "$TMP/init"
PASSPHRASE=$(kv PASSPHRASE "$TMP/init") || die "init on $SERVER_ID printed no PASSPHRASE"
REPOKEY_B64=$(kv REPOKEY_B64 "$TMP/init") || die "init on $SERVER_ID printed no REPOKEY_B64"
RES_REPO=$(kv REPO "$TMP/init") || RES_REPO=None
RES_TIMER=$(kv TIMER "$TMP/init") || RES_TIMER=None

# 5: escrow
ESC="$CFG_DIR/escrow/$SERVER_ID"
mkdir -p "$ESC" \
    && chmod 700 "$ESC" \
    && printf '%s\n' "$PASSPHRASE" > "$ESC/passphrase" \
    && printf '%s' "$REPOKEY_B64" | base64 -d > "$ESC/repokey" \
    && chmod 600 "$ESC/passphrase" "$ESC/repokey" \
    || die "escrow of $SERVER_ID failed"
unset PASSPHRASE
mkdir -p "$CFG_DIR/servers"
chmod 700 "$CFG_DIR/servers"
jq -n --arg id "$SERVER_ID" --arg user "$SUB_USER" --argjson subid "$SUB_ID" --arg repo "$REPO" \
    --arg remote "$REMOTE_PATH" --arg time "$TIME_SLOT" --arg version "$VERSION" \
    --arg enrolled "$(date +%Y-%m-%dT%H:%M:%S%z)" \
    '{server_id: $id, subaccount: $user, subaccount_id: $subid, repo: $repo, remote_path: $remote,
      time: $time, borg_version: $version, enrolled: $enrolled}' > "$CFG_DIR/servers/$SERVER_ID.json"
echo "[$SERVER_ID] repo $RES_REPO $REPO, timer $TIME_SLOT (next $RES_TIMER)"

if [ "$FIRST_RUN" = 1 ]; then
    printf '%s' "sudo systemd-run --collect --unit=borg-fleet-first /usr/local/sbin/borg-fleet-client backup" > "$TMP/cmd"
    mcp_run "$SERVER_ID" "$TMP/cmd" 30
    echo "[$SERVER_ID] first backup started (journalctl -u borg-fleet-first)"
fi
exit 0
